<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Fonts -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UiTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Core MacBook Pure OLED & Obsidian Glass Palette -->
    <Color x:Key="ObsidianBaseTopColor">#FF000000</Color>
    <Color x:Key="ObsidianBaseMidColor">#F4050608</Color>
    <Color x:Key="ObsidianBaseBotColor">#FA030406</Color>
    <Color x:Key="AccentBlueColor">#FF0A84FF</Color>
    <Color x:Key="AccentCyanColor">#FF64D2FF</Color>
    <Color x:Key="AccentGreenColor">#FF30D158</Color>
    <Color x:Key="AccentAmberColor">#FFFF9F0A</Color>
    <Color x:Key="AccentCoralColor">#FFFF453A</Color>
    <Color x:Key="AccentPurpleColor">#FFBF5AF2</Color>

    <!-- Notch & Capsule Shell Brushes -->
    <SolidColorBrush x:Key="NotchOledShellBrush" Color="#FF000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="FloatingOledShellBrush" Color="#F4050608" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianShellBrush" Color="#F4050608" po:Freeze="True"/>

    <LinearGradientBrush x:Key="NotchRimGradientBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.00"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.25"/>
        <GradientStop Color="#15FFFFFF" Offset="0.60"/>
        <GradientStop Color="#22FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="FloatingCapsuleRimBrush" Color="#24FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianOuterRimBrush" Color="#24FFFFFF" po:Freeze="True"/>

    <LinearGradientBrush x:Key="ObsidianTopSpecularBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.22"/>
        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
        <GradientStop Color="#38FFFFFF" Offset="0.78"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Bento Card Surfaces -->
    <SolidColorBrush x:Key="ObsidianCardSurfaceBrush" Color="#0DFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianCardBorderBrush" Color="#18FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianSubCardSurfaceBrush" Color="#12FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianSubCardBorderBrush" Color="#1FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianHoverSurfaceBrush" Color="#1FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ObsidianHoverBorderBrush" Color="#36FFFFFF" po:Freeze="True"/>

    <!-- Text & Accent Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA1A1AA" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF71717A" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF0A84FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF64D2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF30D158" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFFF9F0A" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentCoralBrush" Color="#FFFF453A" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#FFBF5AF2" po:Freeze="True"/>

    <!-- Pre-frozen Control & Transform Resources (Zero BlurEffect / DropShadowEffect) -->
    <LinearGradientBrush x:Key="AccentHeroButtonBackgroundBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#FF1F93FF" Offset="0"/>
        <GradientStop Color="#FF0066E5" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TabPillGradientBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#2BFFFFFF" Offset="0"/>
        <GradientStop Color="#16FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ActionButtonBgBrush" Color="#14FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ActionButtonBorderBrush" Color="#20FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ActionPressedBlueBrush" Color="#3E0A84FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="IconCircleBgBrush" Color="#15FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="IconCircleHoverBgBrush" Color="#26FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="IconCircleHoverBorderBrush" Color="#3CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#14FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboBorderBrush" Color="#24FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboPopupBgBrush" Color="#FA0A0B0F" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboPopupBorderBrush" Color="#2CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightBrush" Color="#2E0A84FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboSelectedBrush" Color="#440A84FF" po:Freeze="True"/>

    <ScaleTransform x:Key="IdentityScaleTransform" ScaleX="1" ScaleY="1" po:Freeze="True"/>
    <ScaleTransform x:Key="PressedScale96Transform" ScaleX="0.96" ScaleY="0.96" po:Freeze="True"/>
    <ScaleTransform x:Key="PressedScale965Transform" ScaleX="0.965" ScaleY="0.965" po:Freeze="True"/>
    <ScaleTransform x:Key="PressedScale91Transform" ScaleX="0.91" ScaleY="0.91" po:Freeze="True"/>
    <ScaleTransform x:Key="PressedScale93Transform" ScaleX="0.93" ScaleY="0.93" po:Freeze="True"/>
    <ScaleTransform x:Key="HoverScale106Transform" ScaleX="1.06" ScaleY="1.06" po:Freeze="True"/>
    <ScaleTransform x:Key="ThumbHoverScaleTransform" ScaleX="1.15" ScaleY="1.15" po:Freeze="True"/>

    <!-- Typography Styles -->
    <Style x:Key="NotchTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="NotchSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="NotchMutedLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Bento Glass Card Containers -->
    <Style x:Key="GlassCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ObsidianCardSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="InnerSubCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ObsidianSubCardSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianSubCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Tactile Obsidian Pill Tab Button (inner Bd scales on press; hit bounds stay fixed) -->
    <Style x:Key="PillTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource IdentityScaleTransform}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            <Setter TargetName="Bd" Property="RenderTransform" Value="{StaticResource PressedScale96Transform}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interactive Action Chip Button (inner Bd scales on press; outer template never scales) -->
    <Style x:Key="DarkActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ActionButtonBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ActionButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource IdentityScaleTransform}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ObsidianHoverSurfaceBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ObsidianHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActionPressedBlueBrush}"/>
                            <Setter TargetName="Bd" Property="RenderTransform" Value="{StaticResource PressedScale96Transform}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Luminous Accent Button -->
    <Style x:Key="AccentHeroButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentHeroButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="#48FFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Apple Control Center Bento Tile Button (inner Bd scales on press) -->
    <Style x:Key="ControlCenterTileStyle" TargetType="Button" BasedOn="{StaticResource DarkActionButtonStyle}">
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource IdentityScaleTransform}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ObsidianHoverBorderBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ObsidianHoverSurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform" Value="{StaticResource PressedScale965Transform}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Circular Header Icon Button (inner Bd scales on press) -->
    <Style x:Key="IconCircleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#FFD4D4D8"/>
        <Setter Property="Background" Value="{StaticResource IconCircleBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianSubCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource IdentityScaleTransform}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource IconCircleHoverBgBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource IconCircleHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform" Value="{StaticResource PressedScale91Transform}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hero White Media Play/Pause Circle Button (inner Bd scales on hover/press; outer hit area static) -->
    <Style x:Key="MediaHeroPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource IconCircleButtonStyle}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Background" Value="#FFF5F5F7"/>
        <Setter Property="Foreground" Value="#FF09090D"/>
        <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource IdentityScaleTransform}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF"/>
                            <Setter Property="Foreground" Value="#FF09090D"/>
                            <Setter TargetName="Bd" Property="RenderTransform" Value="{StaticResource HoverScale106Transform}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#FF09090D"/>
                            <Setter TargetName="Bd" Property="RenderTransform" Value="{StaticResource PressedScale93Transform}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Layout-Free Apple-Style Sleek Dark Slider (fixed 16x16 Thumb Grid; ThumbOrb scales via RenderTransform) -->
    <Style x:Key="ObsidianSliderStyle" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="#24FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}" Margin="2,0"/>
                        <Track x:Name="PART_Track" Margin="0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" CornerRadius="2.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="16" Height="16" Background="Transparent">
                                                <Border x:Name="ThumbOrb"
                                                        Width="13" Height="13" CornerRadius="6.5"
                                                        Background="#FFF5F5F7"
                                                        BorderBrush="#66000000" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        RenderTransform="{StaticResource IdentityScaleTransform}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbOrb" Property="Background" Value="#FFFFFFFF"/>
                                                    <Setter TargetName="ThumbOrb" Property="RenderTransform" Value="{StaticResource ThumbHoverScaleTransform}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbOrb" Property="Background" Value="#FFFFFFFF"/>
                                                    <Setter TargetName="ThumbOrb" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                                    <Setter TargetName="ThumbOrb" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="ThumbOrb" Property="RenderTransform" Value="{StaticResource ThumbHoverScaleTransform}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim Dark Progress Bar -->
    <Style x:Key="ObsidianProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ultra-Minimal Slim Dark ScrollBar (Vertical & Horizontal) + ScrollViewer -->
    <Style x:Key="SlimScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbPill" Background="#3EFFFFFF" CornerRadius="2.5" Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbPill" Property="Background" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbPill" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollBarThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsHitTestVisible="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsHitTestVisible="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SlimVerticalScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource ObsidianScrollBarStyle}"/>

    <!-- Custom Dark Obsidian CheckBox (No light Aero2 square) -->
    <Style x:Key="ObsidianCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="CheckBoxBg"
                                Width="16" Height="16"
                                CornerRadius="4.5"
                                Background="#1CFFFFFF"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CheckGlyph"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="10"
                                       Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxBg" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                            <Setter TargetName="CheckBoxBg" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxBg" Property="BorderBrush" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   Orientation="Vertical"
                                   Style="{StaticResource ObsidianScrollBarStyle}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   Orientation="Horizontal"
                                   Style="{StaticResource ObsidianScrollBarStyle}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Dark Obsidian ComboBox & Dropdown Items with Ellipsis Trimming -->
    <Style x:Key="ObsidianComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                            </Style>
                        </Border.Resources>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboHighlightBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboSelectedBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource ComboBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ComboBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ObsidianComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="10"
                                            MinHeight="30">
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Text="&#xE70D;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ObsidianHoverSurfaceBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ObsidianHoverBorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="10,5,28,5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ToggleButton}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               VerticalOffset="4">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    MaxWidth="360"
                                    MaxHeight="220"
                                    Background="{StaticResource ComboPopupBgBrush}"
                                    BorderBrush="{StaticResource ComboPopupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="4">
                                <ScrollViewer Style="{StaticResource ObsidianScrollViewerStyle}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS-Style Pill Toggle Switch Template for CheckBox -->
    <Style x:Key="IosToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                Background="#2CFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                    Background="#FFF5F5F7"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#55FFFFFF"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="Knob" Property="Background" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Obsidian TextBox Style -->
    <Style x:Key="ObsidianTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ComboBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ComboBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiTextFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ObsidianHoverSurfaceBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource ObsidianSliderStyle}"/>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource ObsidianProgressBarStyle}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ObsidianComboBoxStyle}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ObsidianScrollBarStyle}"/>

</ResourceDictionary>
