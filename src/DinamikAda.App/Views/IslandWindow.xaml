                                                                          Height="23"
                                                                          FontSize="9.2"
                                                                          Margin="0,0,4,0"
                                                                          DropDownOpened="OnAudioComboDropDownOpened"
                                                                          DropDownClosed="OnAudioComboDropDownClosed" />
                                                                <Button x:Name="BtnSchedStart"
                                                                        Grid.Column="2"
                                                                        Style="{StaticResource PillTabButtonStyle}"
                                                                        Padding="7,2"
                                                                        FontSize="9.2"
                                                                        Content="Start"
