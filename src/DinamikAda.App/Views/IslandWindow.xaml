                                            <Grid>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Button x:Name="BtnAiEditDelete"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF2A161A"
                                                            BorderBrush="#44FF453A"
                                                            Foreground="#FFFF6961"
                                                            Padding="9,3.5"
                                                            FontSize="9.8"
                                                            Margin="0,0,6,0"
                                                            Content="Hesabı Sil"
                                                            Click="OnAiEditDeleteClick" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="BtnAiEditCancel"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF232836"
                                                            BorderBrush="#38FFFFFF"
                                                            Padding="10,3.5"
                                                            FontSize="10"
                                                            Margin="0,0,6,0"
                                                            Content="İptal"
                                                            Click="OnAiEditCloseClick" />
                                                    <Button x:Name="BtnAiEditSave"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF122A48"
                                                            BorderBrush="#660A84FF"
                                                            Foreground="{StaticResource AccentCyanBrush}"
                                                            Padding="12,3.5"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Content="Kaydet"
                                                            Click="OnAiEditSaveClick" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Grid>

                    <!-- Open-Top Rim Highlight in NotchFlush / Closed Rim in Floating -->
                    <Path x:Name="NotchRimPath"
                          Stroke="{StaticResource NotchRimGradientBrush}"
                          StrokeThickness="1"
                          IsHitTestVisible="False"
                          Stretch="None" />
                </Grid>
            </Grid>

            <!-- Secondary Live Activity Satellite Pill (S2Split) -->
            <Canvas x:Name="SatelliteVisualRoot"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="150"
                    Height="60"
                    Visibility="Collapsed"
                    MouseEnter="OnSatelliteMouseEnter"
                    MouseLeave="OnSatelliteMouseLeave"
                    MouseLeftButtonDown="OnSatelliteMouseLeftButtonDown"
                    MouseRightButtonUp="OnMainAssemblyMouseRightButtonUp">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SatelliteScaleTransform" CenterX="30" />
                        <TranslateTransform x:Name="SatelliteTranslateTransform" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <Path x:Name="SatelliteHitPath"
                      Fill="#01000000"
                      IsHitTestVisible="False"
                      Cursor="Hand"
                      Stretch="None" />

                <Grid x:Name="SatelliteVisualGroup" IsHitTestVisible="False">
                    <Path x:Name="SatelliteShellPath"
                          Fill="{StaticResource NotchOledShellBrush}"
                          Stretch="None" />

                    <Grid x:Name="SatelliteContentClipHost">
                        <Rectangle x:Name="SatelliteGlowRect"
                                   Width="140"
                                   Height="60"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Opacity="0"
                                   IsHitTestVisible="False">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SatelliteGlowScale" />
                                    <TranslateTransform x:Name="SatelliteGlowTransform" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <LinearGradientBrush x:Name="SatelliteGlowBrush" StartPoint="0,0" EndPoint="1,0.85">
                                    <GradientStop x:Name="AuraSatStop0" Color="#705E5CE6" Offset="0.0" />
                                    <GradientStop x:Name="AuraSatStop1" Color="#560A84FF" Offset="0.48" />
                                    <GradientStop x:Name="AuraSatStop2" Color="#5E64D2FF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid x:Name="SatelliteInnerGrid"
                              Width="84"
                              Height="28"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="SatelliteContentTransform" X="6" Y="4" />
                            </Grid.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="SatelliteAccentDot"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource AccentAmberBrush}"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="SatelliteIconText"
                                           Text="&#xE916;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SatellitePrimaryText"
                                           Text=""
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="56"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Path x:Name="SatelliteRimPath"
                          Stroke="{StaticResource NotchRimGradientBrush}"
                          StrokeThickness="1"
                          Stretch="None" />
                </Grid>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
