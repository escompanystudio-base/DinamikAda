                                <!-- In-Island Glass Overlay: Add / Edit AI Subscription Account -->
                                <Border x:Name="AiQuotaEditOverlay"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Background="#EE050609"
                                        CornerRadius="16"
                                        Visibility="Collapsed"
                                        MouseLeftButtonDown="OnOverlayBackdropMouseDown">
                                    <Border Width="512"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="15"
                                            Background="#FF141822"
                                            BorderBrush="#42FFFFFF"
                                            BorderThickness="1"
                                            Padding="12,9"
                                            MouseLeftButtonDown="OnOverlayCardSwallowMouseDown">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5">
                                                <TextBlock x:Name="AiQuotaEditTitleText"
                                                           Text="AI Abonelik Hesabı Ekle / Düzenle"
