                                                        BorderBrush="#1EFFFFFF"
                                                        BorderThickness="0.6"
                                                        Padding="8,5"
                                                        Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Name="BtnVoiceNoteToggle"
                                                                    Grid.Column="0"
                                                                    Style="{StaticResource PillTabButtonStyle}"
                                                                    Padding="8,3"
                                                                    FontSize="10"
                                                                    Click="OnVoiceNoteToggleClick">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="VoiceNoteGlyphText"
                                                                               Text="&#xE720;"
                                                                               FontFamily="{StaticResource IconFont}"
                                                                               FontSize="10"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,5,0" />
                                                                    <TextBlock x:Name="VoiceNoteLabelText"
                                                                               Text="Sesli Not"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Canvas x:Name="VoiceNoteWaveCanvas"
                                                                    Grid.Column="1"
                                                                    Width="52" Height="16"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <Border Canvas.Left="2" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentAmberBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale0" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="8" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentAmberBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale1" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="14" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentCyanBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale2" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="20" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentCyanBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale3" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="26" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentCyanBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale4" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="32" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBlueBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale5" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="38" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBlueBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale6" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                                <Border Canvas.Left="44" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBlueBrush}"><Border.RenderTransform><ScaleTransform x:Name="VoiceWaveScale7" ScaleX="1" ScaleY="0.18" CenterX="1.5" CenterY="16" /></Border.RenderTransform></Border>
                                                            </Canvas>
                                                            <Border x:Name="AudioFormatBadgeBorder"
                                                                    Grid.Column="2"
                                                                    CornerRadius="6"
                                                                    Background="#180A84FF"
                                                                    BorderBrush="#360A84FF"
                                                                    BorderThickness="0.6"
                                                                    Padding="6,2"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonUp="OnMediaQualityBadgeClick"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock x:Name="AudioFormatBadgeText"
                                                                           Text="48 kHz"
                                                                           FontFamily="{StaticResource UiTextFont}"
                                                                           FontSize="9.2"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource AccentBlueBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="VoiceNotePathText"
                                                                       Grid.Column="0"
                                                                       Text=""
                                                                       FontFamily="{StaticResource UiTextFont}"
                                                                       FontSize="8.8"
