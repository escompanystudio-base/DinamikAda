                                                        <StackPanel>
                                                            <TextBlock x:Name="SchedPowerHeaderText"
                                                                       Text="Scheduled Action"
                                                                       FontFamily="{StaticResource UiTextFont}"
                                                                       FontSize="8.8"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="0,0,0,2" />
