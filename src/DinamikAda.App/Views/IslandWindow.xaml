<Window x:Class="DinamikAda.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        SizeToContent="Manual"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ObsidianGlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{x:Null}" Margin="0">
        <!-- Fixed host sized strictly at expanded tier interactively (720x424) so HWND never resizes/jumps on hover. -->
        <Canvas x:Name="TierHostCanvas"
                Width="720"
                Height="424"
                Margin="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ClipToBounds="False">

            <!-- Narrow top drag-catcher band, visible ONLY while an external OS drag is armed and capsule is collapsed -->
            <Border x:Name="DragCatcherBand"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="720"
                    Height="80"
                    Background="#01000000"
                    Visibility="Collapsed"
                    AllowDrop="True" />

            <!-- Primary MacBook Notch / Floating Capsule Assembly -->
            <Grid x:Name="MainNotchAssembly"
                  Canvas.Left="0"
                  Canvas.Top="0"
                  Width="720"
                  Height="424"
                  RenderTransformOrigin="0,0"
                  MouseEnter="OnMainAssemblyMouseEnter"
                  MouseLeave="OnMainAssemblyMouseLeave"
                  MouseLeftButtonDown="OnMainAssemblyMouseLeftButtonDown"
                  MouseMove="OnMainAssemblyMouseMove"
                  MouseLeftButtonUp="OnMainAssemblyMouseLeftButtonUp"
                  MouseRightButtonUp="OnMainAssemblyMouseRightButtonUp"
                  MouseWheel="OnMainAssemblyMouseWheel"
                  LostMouseCapture="OnExpandedSurfaceLostMouseCapture">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MainOffsetTransform" X="0" Y="0" />
                </Grid.RenderTransform>

                <!-- The hit surface follows the shell geometry without the hover scale. -->
                <Path x:Name="NotchHitPath"
                      Fill="#01000000"
                      IsHitTestVisible="True"
                      Stretch="None" />

                <!-- Visual shell scaled smoothly on hover/press without altering hit-test bounds -->
                <Grid x:Name="NotchVisualRoot" IsHitTestVisible="True">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MainHoverScaleTransform"
                                        ScaleX="1"
                                        ScaleY="1"
                                        CenterX="360"
                                        CenterY="0" />
                    </Grid.RenderTransform>

                    <!-- Pure OLED Pitch-Black Shell -->
                    <Path x:Name="NotchShellPath"
                          Fill="{StaticResource NotchOledShellBrush}"
                          IsHitTestVisible="False"
                          Stretch="None" />

                    <!-- Content clipped directly to dynamic PathGeometry contour -->
                    <Grid x:Name="NotchContentClipHost" IsHitTestVisible="True">
                        <Canvas x:Name="NotchContentCanvas"
                                Width="720"
                                Height="424"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">

                            <!-- Dynamic Multi-Layer Album / State Ambient Glow inside OLED contour -->
                            <Canvas x:Name="AccentGlowHost"
                                    Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="720"
                                    Height="424"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Rectangle x:Name="AccentGlowWash" Width="640" Height="300" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="AccentGlowWashScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0" />
                                            <TranslateTransform x:Name="AccentGlowWashTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                            <GradientStop x:Name="AuraWashStop0" Color="#2C0A84FF" Offset="0.0" />
                                            <GradientStop x:Name="AuraWashStop1" Color="#225E5CE6" Offset="0.52" />
                                            <GradientStop x:Name="AuraWashStop2" Color="#1A64D2FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="AccentGlowPrimary" Width="520" Height="340" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="AccentGlowPrimaryScale" ScaleX="1" ScaleY="1" CenterX="260" CenterY="170" />
                                            <TranslateTransform x:Name="AccentGlowPrimaryTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop x:Name="AuraStop0" Color="#580A84FF" Offset="0.0" />
                                            <GradientStop x:Name="AuraStop1" Color="#4C0A84FF" Offset="0.24" />
                                            <GradientStop x:Name="AuraStop2" Color="#2E0A84FF" Offset="0.50" />
                                            <GradientStop x:Name="AuraStop3" Color="#100A84FF" Offset="0.76" />
                                            <GradientStop Color="#00000000" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="AccentGlowSecondary" Width="480" Height="320" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="AccentGlowSecondaryScale" ScaleX="1" ScaleY="1" CenterX="240" CenterY="160" />
                                            <TranslateTransform x:Name="AccentGlowSecondaryTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop x:Name="AuraSecStop0" Color="#4E5E5CE6" Offset="0.0" />
                                            <GradientStop x:Name="AuraSecStop1" Color="#425E5CE6" Offset="0.24" />
                                            <GradientStop x:Name="AuraSecStop2" Color="#285E5CE6" Offset="0.50" />
                                            <GradientStop x:Name="AuraSecStop3" Color="#0E5E5CE6" Offset="0.76" />
                                            <GradientStop Color="#00000000" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="AccentGlowHighlight" Width="440" Height="300" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="AccentGlowHighlightScale" ScaleX="1" ScaleY="1" CenterX="220" CenterY="150" />
                                            <TranslateTransform x:Name="AccentGlowHighlightTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop x:Name="AuraHiStop0" Color="#4264D2FF" Offset="0.0" />
                                            <GradientStop x:Name="AuraHiStop1" Color="#3864D2FF" Offset="0.24" />
                                            <GradientStop x:Name="AuraHiStop2" Color="#2264D2FF" Offset="0.50" />
                                            <GradientStop x:Name="AuraHiStop3" Color="#0C64D2FF" Offset="0.76" />
                                            <GradientStop Color="#00000000" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Canvas>

                            <!-- Fullscreen Edge-Peek Hairline Surface (68x4) -->
                            <Border x:Name="HairlineSurface"
                                    Width="68"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#7012151C"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="0.6"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="HairlineSurfaceTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="{StaticResource AccentBlueBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Border>

                            <!-- S1 Dormant MacBook Hardware Notch -->
                            <Grid x:Name="DormantNotchSurface"
                                  Width="164"
                                  Height="24"
                                  Visibility="Collapsed"
                                  IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="DormantSurfaceTransform" X="0" Y="0" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">
                                    <Ellipse x:Name="DormantStatusDot"
                                             Width="4"
                                             Height="4"
                                             Fill="#FF30D158"
                                             Opacity="0.0"
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0" />
                                    <TextBlock x:Name="DormantAppTag"
                                               Text=""
                                               FontFamily="{StaticResource UiTextFont}"
                                               FontSize="9.5"
                                               FontWeight="Medium"
                                               Foreground="#70FFFFFF"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </StackPanel>

                                <!-- Centered MacBook Sapphire Camera Lens Detail -->
                                <Grid x:Name="DormantCameraLensHost"
                                      Grid.Column="1"
                                      Width="12"
                                      Height="12"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">
                                    <Ellipse Width="11"
                                             Height="11"
                                             Fill="#FF080A0F"
                                             Stroke="#FF181D29"
                                             StrokeThickness="1" />
                                    <Ellipse Width="6.2"
                                             Height="6.2"
                                             Fill="#FF050811"
                                             Stroke="#FF1E3A8A"
                                             StrokeThickness="0.7" />
                                    <Ellipse Width="2.2"
                                             Height="2.2"
                                             Margin="2.2,2.2,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="#8860A5FA" />
                                </Grid>

                                <!-- Optional Compact Live Telemetry -->
                                <TextBlock x:Name="DormantTelemetryText"
                                           Grid.Column="2"
                                           Text=""
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                            </Grid>

                            <!-- S2 Compact / Split Primary Pill -->
                            <Grid x:Name="CompactSurface"
                                  Width="256"
                                  Height="30"
                                  Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="CompactSurfaceTransform" X="0" Y="0" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Concentric 22x22 R=5 outer / 20x20 R=4 inner album or icon box -->
                                <Border x:Name="CompactThumbBorder"
                                        Grid.Column="0"
                                        Width="22"
                                        Height="22"
                                        CornerRadius="5"
                                        Background="#1AFFFFFF"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="0.6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <Image x:Name="CompactAlbumImage"
                                               Width="20"
                                               Height="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,20,20" RadiusX="4" RadiusY="4" />
                                            </Image.Clip>
                                        </Image>
                                        <TextBlock x:Name="CompactLeadingGlyph"
                                                   Text="&#xE8D6;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Ellipse x:Name="CompactSensorDot"
                                                 Width="5"
                                                 Height="5"
                                                 Fill="{StaticResource AccentAmberBrush}"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Margin="0,1,1,0"
                                                 Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <!-- Compact Title + Artist / Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="CompactPrimaryText"
                                               Style="{StaticResource NotchTitleTextStyle}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CompactSecondaryText"
                                               Style="{StaticResource NotchSubtitleTextStyle}"
                                               FontSize="9.8"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,-1,0,0" />
                                </StackPanel>

                                <!-- Right Live Visualizer / Badge -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Canvas x:Name="CompactSpectrumCanvas"
                                            Width="32"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Visibility="Visible">
                                        <Border x:Name="SpecBar0" Canvas.Left="1" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentBlueBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale0" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar1" Canvas.Left="5" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentBlueBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale1" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar2" Canvas.Left="9" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentCyanBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale2" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar3" Canvas.Left="13" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentCyanBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale3" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar4" Canvas.Left="17" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentCyanBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale4" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar5" Canvas.Left="21" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentBlueBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale5" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar6" Canvas.Left="25" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentBlueBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale6" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpecBar7" Canvas.Left="29" Canvas.Top="1" Width="2.3" Height="14" CornerRadius="1.15" Background="{StaticResource AccentBlueBrush}">
                                            <Border.RenderTransform><ScaleTransform x:Name="SpecScale7" ScaleX="1" ScaleY="0.2" CenterX="1.15" CenterY="14" /></Border.RenderTransform>
                                        </Border>
                                    </Canvas>

                                    <TextBlock x:Name="CompactBadgeText"
                                               FontFamily="{StaticResource UiTextFont}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>

                            <!-- S3 Transient HUD Banner -->
                            <Grid x:Name="TransientHudSurface"
                                  Width="284"
                                  Height="34"
                                  Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="TransientHudTransform" X="0" Y="0" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HudIconWell"
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#20FFFFFF"
                                        BorderBrush="#2AFFFFFF"
                                        BorderThickness="0.6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,9,0">
                                    <TextBlock x:Name="HudIconGlyph"
                                               Text="&#xE767;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HudTitleText"
                                               Style="{StaticResource NotchTitleTextStyle}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HudSubtitleText"
                                               Style="{StaticResource NotchSubtitleTextStyle}"
                                               FontSize="9.8"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed" />
                                    <ProgressBar x:Name="HudProgressBar"
                                                 Style="{StaticResource ObsidianProgressBarStyle}"
                                                 Height="4"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 Value="0.5"
                                                 Margin="0,4,0,0"
                                                 Visibility="Collapsed" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="HudPercentText"
                                               FontFamily="{StaticResource UiTextFont}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="HudActionButton"
                                            Style="{StaticResource PillTabButtonStyle}"
                                            Padding="9,3"
                                            FontSize="10.5"
                                            Margin="8,0,0,0"
                                            Visibility="Collapsed"
                                            Click="OnHudActionClick" />
                                    <Button x:Name="HudSecondaryActionButton"
                                            Style="{StaticResource PillTabButtonStyle}"
                                            Padding="9,3"
                                            FontSize="10.5"
                                            Margin="5,0,0,0"
                                            Visibility="Collapsed"
                                            Click="OnHudSecondaryActionClick" />
                                </StackPanel>
                            </Grid>

                            <!-- S6 Drag & AirDrop Shelf Drop Zone -->
                            <Grid x:Name="DragShelfSurface"
                                  Width="384"
                                  Height="138"
                                  Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="DragShelfTransform" X="0" Y="0" />
                                </Grid.RenderTransform>

                                <Border x:Name="DragDropWell"
                                        CornerRadius="16"
                                        Background="#0E64D2FF"
                                        BorderBrush="#4864D2FF"
                                        BorderThickness="1"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="34"
                                                    Height="34"
                                                    CornerRadius="17"
                                                    Background="#2464D2FF"
                                                    BorderBrush="#4064D2FF"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,6">
                                                <TextBlock Text="&#xE896;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="15"
                                                           Foreground="{StaticResource AccentCyanBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="DragHintTitle"
                                                       Text="Drop files or text onto the island"
                                                       Style="{StaticResource NotchTitleTextStyle}"
                                                       FontSize="12.5"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DragHintSub"
                                                       Text="AirDrop Shelf Pocket • Instant stash &amp; share"
                                                       Style="{StaticResource NotchSubtitleTextStyle}"
                                                       FontSize="10.2"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <Button x:Name="DragOpenShelfButton"
                                                    Style="{StaticResource DarkActionButtonStyle}"
                                                    Padding="12,5"
                                                    FontSize="11"
                                                    Content="Open Shelf"
                                                    Click="OnDragOpenShelfClick" />
                                            <Button x:Name="DragQrShareButton"
                                                    Style="{StaticResource DarkActionButtonStyle}"
                                                    Padding="12,5"
                                                    FontSize="11"
                                                    Margin="8,0,0,0"
                                                    Content="QR AirDrop"
                                                    Click="OnShelfQrClick" />
                                            <Button x:Name="DragCancelButton"
                                                    Style="{StaticResource DarkActionButtonStyle}"
                                                    Padding="12,5"
                                                    FontSize="11"
                                                    Margin="8,0,0,0"
                                                    Content="Close"
                                                    Click="OnDragCancelClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- S5 Spotlight Command Palette -->
                            <Grid x:Name="CommandSurface"
                                  Width="536"
                                  Height="342"
                                  Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="CommandSurfaceTransform" X="0" Y="0" />
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Spotlight Search Bar -->
                                <Border Grid.Row="0"
                                        Height="46"
                                        CornerRadius="14"
                                        Background="#14FFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="0.8"
                                        Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE721;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="CommandPlaceholderText"
                                                       Text="Search apps, windows, commands (= math, > shell, @ win)..."
                                                       FontFamily="{StaticResource UiTextFont}"
                                                       FontSize="13.5"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                            <TextBox x:Name="CommandSearchBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     CaretBrush="{StaticResource AccentBlueBrush}"
                                                     SelectionBrush="{StaticResource AccentBlueBrush}"
                                                     FontFamily="{StaticResource UiTextFont}"
                                                     FontSize="13.5"
                                                     VerticalAlignment="Center"
                                                     TextChanged="OnCommandQueryChanged"
                                                     PreviewKeyDown="OnCommandSearchPreviewKeyDown" />
                                        </Grid>

                                        <Border Grid.Column="2"
                                                CornerRadius="7"
                                                Background="#18FFFFFF"
                                                BorderBrush="#24FFFFFF"
                                                BorderThickness="0.6"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="ESC"
                                                       FontFamily="{StaticResource UiTextFont}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Spotlight Result Rows (Single-Click Execution + Keyboard Navigation) -->
                                <ListBox x:Name="CommandResultsList"
                                         Grid.Row="1"
                                         Margin="0,10,0,8"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseLeftButtonUp="OnCommandResultPreviewMouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBd"
                                                                Height="44"
                                                                CornerRadius="11"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0.8"
                                                                Padding="10,6"
                                                                Cursor="Hand">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBd" Property="Background" Value="#14FFFFFF" />
                                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="#24FFFFFF" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBd" Property="Background" Value="#220A84FF" />
                                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="#550A84FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="8"
                                                        Background="#16FFFFFF"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="10.2"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Border CornerRadius="6"
                                                            Background="#14FFFFFF"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="9.8"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Footer Keycap Hints -->
                                <TextBlock x:Name="CommandStatusText"
                                           Visibility="Collapsed"
                                           Grid.Row="2"
                                           Background="#FF101014"
                                           Foreground="#FFFF766E"
                                           FontSize="10.5"
                                           MaxHeight="42"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False" />
                                <Border Grid.Row="3"
                                        CornerRadius="10"
                                        Background="#0AFFFFFF"
                                        BorderBrush="#14FFFFFF"
                                        BorderThickness="0.6"
                                        Padding="10,5">
                                    <Grid>
                                        <TextBlock x:Name="CmdSyntaxHintsText"
                                                   Text="@ Windows   # Clipboard   = Calculator   &gt; Shell"
                                                   FontFamily="{StaticResource UiTextFont}"
                                                   FontSize="10.2"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="CmdKeyHintsText"
                                                   Text="↑↓ Navigate   ↵ Run   Esc Close"
                                                   FontFamily="{StaticResource UiTextFont}"
                                                   FontSize="10.2"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- S4 Expanded MacBook Nook Bento Hub -->
                            <Grid x:Name="ExpandedSurface"
                                  Width="588"
                                  Height="256"
                                  Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ExpandedSurfaceScaleTransform" ScaleX="1" ScaleY="1" CenterX="294" CenterY="0" />
                                        <TranslateTransform x:Name="ExpandedSurfaceTransform" X="0" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Top Tab Strip & Utility Chrome -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="TabStripHost" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <!-- Sliding active pill inside isolated Canvas so indicator motion triggers ZERO layout -->
                                        <Canvas x:Name="TabIndicatorCanvas" Height="26" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Border x:Name="TabIndicatorPill"
                                                    Canvas.Left="0"
                                                    Canvas.Top="0"
                                                    Width="56"
                                                    Height="26"
                                                    CornerRadius="13"
                                                    Background="#24FFFFFF"
                                                    BorderBrush="#36FFFFFF"
                                                    BorderThickness="0.8">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="TabIndicatorTransform" X="0" Y="0" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Canvas>

                                        <StackPanel x:Name="TabButtonsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="TabBtnNow" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="Feed" Tag="Now" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                            <Button x:Name="TabBtnAudio" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="Audio" Tag="Audio" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                            <Button x:Name="TabBtnControl" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="Control" Tag="Control" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                            <Button x:Name="TabBtnShelf" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="Shelf" Tag="Shelf" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                            <Button x:Name="TabBtnSystem" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="System" Tag="System" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                            <Button x:Name="TabBtnWidgets" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="Widgets" Tag="Widgets" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                            <Button x:Name="TabBtnAiQuota" Style="{StaticResource PillTabButtonStyle}" Padding="8,4" Content="AI Kota" Tag="AiQuota" Click="OnTabButtonClick" SizeChanged="OnTabButtonSizeChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Right Utility Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="QuietIslandBtn"
                                                Style="{StaticResource IconCircleButtonStyle}"
                                                Content="&#xE708;"
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Click="OnQuietIslandClick" />
                                        <Button x:Name="OpenCommandBtn"
                                                Style="{StaticResource IconCircleButtonStyle}"
                                                Content="&#xE721;"
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Click="OnOpenCommandClick" />
                                        <Button x:Name="PinToggleBtn"
                                                Style="{StaticResource IconCircleButtonStyle}"
                                                Content="&#xE718;"
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Click="OnPinToggleClick" />
                                        <Button x:Name="SettingsHeaderBtn"
                                                Style="{StaticResource IconCircleButtonStyle}"
                                                Content="&#xE713;"
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Click="OnOpenSettingsClick" />
                                        <Button x:Name="CollapseHeaderBtn"
                                                Style="{StaticResource IconCircleButtonStyle}"
                                                Content="&#xE70E;"
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="11.5"
                                                Click="OnCollapseHeaderClick" />
                                    </StackPanel>
                                </Grid>

                                <!-- Tab Content Area with Pure RenderTransform Slide/Scale -->
                                <Grid x:Name="TabContentHost" Grid.Row="1">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="TabContentScaleTransform" ScaleX="1" ScaleY="1" CenterX="294" CenterY="100" />
                                            <TranslateTransform x:Name="TabContentSlideTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>

                                    <!-- 1. NOW TAB (2 Horizontal Bento Cards) -->
                                    <Grid x:Name="TabNowPanel" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.38*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Hero Media Player Bento Card -->
                                        <Border Grid.Column="0" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="16" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Concentric 76x76 R=14 outer / 74x74 R=13 inner album art -->
                                                    <Border x:Name="ExpandedArtBorder"
                                                            Grid.Column="0"
                                                            Width="74"
                                                            Height="74"
                                                            CornerRadius="14"
                                                            Background="#18FFFFFF"
                                                            BorderBrush="#24FFFFFF"
                                                            BorderThickness="0.8"
                                                            Margin="0,0,12,0">
                                                        <Grid>
                                                            <Image x:Name="ExpandedAlbumArt"
                                                                   Width="72"
                                                                   Height="72"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Stretch="UniformToFill">
                                                                <Image.Clip>
                                                                    <RectangleGeometry Rect="0,0,72,72" RadiusX="13" RadiusY="13" />
                                                                </Image.Clip>
                                                            </Image>
                                                            <TextBlock x:Name="ExpandedArtFallback"
                                                                       Text="&#xE8D6;"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="24"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        CornerRadius="6"
                                                                        Background="#16FFFFFF"
                                                                        Padding="6,2"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock x:Name="NowMediaAppText"
                                                                               Text="Media"
                                                                               FontFamily="{StaticResource UiTextFont}"
                                                                               FontSize="9.8"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource AccentCyanBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                                <Border x:Name="NowMediaQualityBadge"
                                                                        Grid.Column="1"
                                                                        CornerRadius="6"
                                                                        Background="#180A84FF"
                                                                        BorderBrush="#360A84FF"
                                                                        BorderThickness="0.6"
                                                                        Padding="6,2"
                                                                        Margin="5,0,0,0"
                                                                        Cursor="Hand"
                                                                        MouseLeftButtonUp="OnMediaQualityBadgeClick"
                                                                        Visibility="Collapsed"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock x:Name="NowMediaQualityText"
                                                                               Text="48 kHz"
                                                                               FontFamily="{StaticResource UiTextFont}"
                                                                               FontSize="9.2"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource AccentBlueBrush}" />
                                                                </Border>
                                                            </Grid>

                                                            <StackPanel x:Name="SessionSwitcherPanel"
                                                                        Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        Margin="6,0,0,0"
                                                                        Visibility="Collapsed">
                                                                <Button x:Name="BtnPrevSession"
                                                                        Style="{StaticResource IconCircleButtonStyle}"
                                                                        Width="20" Height="20" FontSize="9"
                                                                        Content="&#xE76B;" FontFamily="{StaticResource IconFont}"
                                                                        Click="OnPrevMediaSessionClick" />
                                                                <TextBlock x:Name="NowSessionIndexText"
                                                                           Text="1/2"
                                                                           FontFamily="{StaticResource UiTextFont}"
                                                                           FontSize="9.5"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0" />
                                                                <Button x:Name="BtnNextSession"
                                                                        Style="{StaticResource IconCircleButtonStyle}"
                                                                        Width="20" Height="20" FontSize="9"
                                                                        Content="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                                        Click="OnNextMediaSessionClick" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock x:Name="NowMediaTitle"
                                                                   Text="No active media"
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="NowMediaArtist"
                                                                   Text=""
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="11.2"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,1,0,0" />
                                                        <TextBlock x:Name="NowMediaLyricLine"
                                                                   Text=""
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="10.2"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource AccentCyanBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Scrubber Timeline -->
                                                <Grid Grid.Row="2" Margin="0,8,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="NowElapsedText"
                                                               Grid.Column="0"
                                                               Text="0:00"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <Slider x:Name="MediaSeekSlider"
                                                            Grid.Column="1"
                                                            Style="{StaticResource ObsidianSliderStyle}"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="0"
                                                            IsMoveToPointEnabled="True"
                                                            Thumb.DragStarted="OnMediaSeekDragStarted"
                                                            Thumb.DragCompleted="OnMediaSeekDragCompleted"
                                                            PreviewMouseLeftButtonUp="OnMediaSeekPreviewMouseLeftButtonUp"
                                                            PreviewKeyUp="OnMediaSeekPreviewKeyUp" />
                                                    <TextBlock x:Name="NowDurationText"
                                                               Grid.Column="2"
                                                               Text="0:00"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </Grid>

                                                <!-- Hero Playback Controls -->
                                                <StackPanel Grid.Row="3"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button x:Name="BtnPrevTrack"
                                                            Style="{StaticResource IconCircleButtonStyle}"
                                                            Width="30"
                                                            Height="30"
                                                            FontFamily="{StaticResource IconFont}"
                                                            FontSize="12"
                                                            Content="&#xE892;"
                                                            Click="OnPrevTrackClick" />
                                                    <Button x:Name="BtnPlayPause"
                                                            Style="{StaticResource MediaHeroPlayButtonStyle}"
                                                            Width="38"
                                                            Height="38"
                                                            Margin="14,0"
                                                            FontFamily="{StaticResource IconFont}"
                                                            FontSize="14"
                                                            Content="&#xE768;"
                                                            Click="OnPlayPauseClick" />
                                                    <Button x:Name="BtnNextTrack"
                                                            Style="{StaticResource IconCircleButtonStyle}"
                                                            Width="30"
                                                            Height="30"
                                                            FontFamily="{StaticResource IconFont}"
                                                            FontSize="12"
                                                            Content="&#xE893;"
                                                            Click="OnNextTrackClick" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Right Column: Focus Timers & Notifications -->
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="1*" />
                                            </Grid.RowDefinitions>

                                            <!-- Focus Timers Bento Card -->
                                            <Border Grid.Row="0" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="9,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <TextBlock x:Name="NowTimersHeaderText"
                                                                   Text="Focus Timer"
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.8" Content="+5m" Click="OnAdd5MinTimerClick" />
                                                            <Button Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.8" Margin="3,0,0,0" Content="+25m" Click="OnAddPomodoroTimerClick" />
                                                            <Button Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.8" Margin="3,0,0,0" Content="&#xE916;" FontFamily="{StaticResource IconFont}" Click="OnAddStopwatchClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Grid.Row="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="NowMeetingBanner"
                                                                Grid.Row="0"
                                                                CornerRadius="9"
                                                                Background="#1C30D158"
                                                                BorderBrush="#4230D158"
                                                                BorderThickness="0.7"
                                                                Padding="7,4"
                                                                Margin="0,0,0,4"
                                                                Visibility="Collapsed">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <TextBlock x:Name="NowMeetingCountdownText"
                                                                               Text="Toplantı • 4:12"
                                                                               FontFamily="{StaticResource UiTextFont}"
                                                                               FontSize="10.2"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource AccentGreenBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock x:Name="NowMeetingTitleText"
                                                                               Text=""
                                                                               FontFamily="{StaticResource UiTextFont}"
                                                                               FontSize="9.4"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button x:Name="BtnMeetingMicToggle"
                                                                            Style="{StaticResource IconCircleButtonStyle}"
                                                                            Width="22" Height="22" FontSize="10"
                                                                            FontFamily="{StaticResource IconFont}"
                                                                            Content="&#xE720;"
                                                                            Margin="0,0,4,0"
                                                                            Click="OnMeetingMicToggleClick" />
                                                                    <Button x:Name="BtnMeetingJoin"
                                                                            Style="{StaticResource PillTabButtonStyle}"
                                                                            Padding="7,2" FontSize="9.5"
                                                                            Content="Katıl"
                                                                            Click="OnMeetingJoinClick" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ScrollViewer Grid.Row="1" Style="{StaticResource ObsidianScrollViewerStyle}">
                                                            <StackPanel x:Name="NowTimersStack" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Notifications Bento Card -->
                                            <Border Grid.Row="2" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="9,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <TextBlock x:Name="NowNotificationsHeaderText"
                                                                   Text="Notifications"
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Button x:Name="BtnClearNotifications"
                                                                Style="{StaticResource PillTabButtonStyle}"
                                                                Padding="7,2"
                                                                FontSize="9.8"
                                                                Content="Clear"
                                                                HorizontalAlignment="Right"
                                                                Click="OnClearNotificationsClick" />
                                                    </Grid>
                                                    <ScrollViewer Grid.Row="1" Style="{StaticResource ObsidianScrollViewerStyle}">
                                                        <Grid>
                                                            <StackPanel x:Name="NowNotificationsStack" />
                                                            <TextBlock x:Name="NowNoNotificationsText"
                                                                       Text="No unread notifications"
                                                                       FontFamily="{StaticResource UiTextFont}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="Collapsed" />
                                                        </Grid>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- 2. AUDIO TAB (Device Endpoints, Sliders, Mini Spectrum + Per-App Mixer) -->
                                    <Grid x:Name="TabAudioPanel" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="16" Padding="12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock x:Name="AudioDevicesHeaderText"
                                                               Text="Audio &amp; Devices"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Canvas x:Name="AudioSpectrumCanvas"
                                                            Width="32"
                                                            Height="14"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                        <Border Canvas.Left="1" Canvas.Top="0" Width="2.2" Height="14" CornerRadius="1.1" Background="{StaticResource AccentBlueBrush}">
                                                            <Border.RenderTransform><ScaleTransform x:Name="AudioSpecScale0" ScaleX="1" ScaleY="0.2" CenterX="1.1" CenterY="14" /></Border.RenderTransform>
                                                        </Border>
