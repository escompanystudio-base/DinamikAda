                                                    <UniformGrid Columns="3" Margin="0,0,0,3">
                                                        <Button x:Name="PowerEffBtn" Style="{StaticResource PillTabButtonStyle}" Padding="4,2" FontSize="9" Content="Eco" Click="OnPowerEffClick" />
                                                        <Button x:Name="PowerBalBtn" Style="{StaticResource PillTabButtonStyle}" Padding="4,2" FontSize="9" Margin="3,0" Content="Bal" Click="OnPowerBalClick" />
                                                        <Button x:Name="PowerPerfBtn" Style="{StaticResource PillTabButtonStyle}" Padding="4,2" FontSize="9" Content="Perf" Click="OnPowerPerfClick" />
