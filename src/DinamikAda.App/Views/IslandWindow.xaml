                                                                <TextBlock x:Name="ShelfQrTitleText"
                                                                           Text="LAN Paylaşım"
                                                                           FontFamily="{StaticResource UiTextFont}"
                                                                           FontSize="10.8"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock x:Name="ShelfQrHintText"
                                                                           Text="Aynı ağda kamerayla okut"
                                                                           FontFamily="{StaticResource UiTextFont}"
                                                                           FontSize="9.0"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,3" />
                                                                <TextBlock x:Name="ShelfQrUrlText"
                                                                           Text="http://..."
                                                                           FontFamily="{StaticResource UiTextFont}"
                                                                           FontSize="9.0"
                                                                           Foreground="{StaticResource AccentCyanBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Cursor="Hand"
                                                                           MouseLeftButtonUp="OnShelfQrUrlClick"
                                                                           Margin="0,0,0,6" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button x:Name="BtnShelfQrCopyUrl" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Content="Kopyala" Click="OnShelfQrCopyClick" />
                                                                    <Button x:Name="BtnShelfQrStop" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="4,0,0,0" Content="Durdur" Click="OnShelfQrStopClick" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="16" Padding="10,9">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <TextBlock x:Name="ClipboardHeaderTitle"
                                                               Text="Clipboard Vault"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Button x:Name="BtnClipClearUnpinned"
                                                            Style="{StaticResource PillTabButtonStyle}"
                                                            Padding="7,2"
                                                            FontSize="9.8"
                                                            Content="Clear Unpinned"
                                                            HorizontalAlignment="Right"
                                                            Click="OnClipboardClearUnpinnedClick" />
                                                </Grid>
                                                <ScrollViewer Grid.Row="1" Style="{StaticResource ObsidianScrollViewerStyle}">
                                                    <Grid>
                                                        <StackPanel x:Name="ClipboardItemsStack" />
                                                        <TextBlock x:Name="ClipboardEmptyText"
                                                                   Text="No clipboard history"
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 5. SYSTEM TELEMETRY TAB -->
                                    <Grid x:Name="TabSystemPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,6">
                                            <Border Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="10,7" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="SysCpuLabel" Text="CPU" FontFamily="{StaticResource UiTextFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock x:Name="SysCpuVal" Text="0%" FontFamily="{StaticResource UiTextFont}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,4" />
                                                    <ProgressBar x:Name="SysCpuBar" Style="{StaticResource ObsidianProgressBarStyle}" Height="4" Minimum="0" Maximum="100" Value="0" />
                                                    <TextBlock x:Name="SysGpuSub" Text="GPU 0%" FontFamily="{StaticResource UiTextFont}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="10,7" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="SysMemLabel" Text="Memory" FontFamily="{StaticResource UiTextFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock x:Name="SysMemVal" Text="0%" FontFamily="{StaticResource UiTextFont}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,4" />
                                                    <ProgressBar x:Name="SysMemBar" Style="{StaticResource ObsidianProgressBarStyle}" Height="4" Minimum="0" Maximum="100" Value="0" />
                                                    <TextBlock x:Name="SysMemSub" Text="0 / 0 GB" FontFamily="{StaticResource UiTextFont}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="10,7" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="SysNetLabel" Text="Network" FontFamily="{StaticResource UiTextFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock x:Name="SysNetDownVal" Text="0.0 Mb/s" FontFamily="{StaticResource UiTextFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,2,0,5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SysNetUpSub" Text="Up 0.0 Mb/s" FontFamily="{StaticResource UiTextFont}" FontSize="9.8" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="10,7">
                                                <StackPanel>
                                                    <TextBlock x:Name="SysBatLabel" Text="Battery" FontFamily="{StaticResource UiTextFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock x:Name="SysBatVal" Text="AC" FontFamily="{StaticResource UiTextFont}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,2,0,4" />
                                                    <ProgressBar x:Name="SysBatBar" Style="{StaticResource ObsidianProgressBarStyle}" Height="4" Minimum="0" Maximum="100" Value="100" />
                                                    <TextBlock x:Name="SysBatSub" Text="Plugged In" FontFamily="{StaticResource UiTextFont}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Grid.Row="1" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="12" Padding="10,5" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock x:Name="SysGpuDetailLabel" Text="GPU VRAM &amp; Sıcaklık" FontFamily="{StaticResource UiTextFont}" FontSize="9.2" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock x:Name="SysGpuDetailText" Text="--" FontFamily="{StaticResource UiTextFont}" FontSize="10.4" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock x:Name="SysDiskDetailLabel" Text="Disk &amp; I/O" FontFamily="{StaticResource UiTextFont}" FontSize="9.2" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock x:Name="SysDiskDetailText" Text="--" FontFamily="{StaticResource UiTextFont}" FontSize="10.4" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="SysPingDetailLabel" Text="Gecikme" FontFamily="{StaticResource UiTextFont}" FontSize="9.2" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock x:Name="SysPingDetailText" Text="--" FontFamily="{StaticResource UiTextFont}" FontSize="10.4" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="11" Padding="7,4" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="BtnSysCleanDisk" Style="{StaticResource DarkActionButtonStyle}" Padding="9,2.5" FontSize="9.8" Margin="0,0,6,0" Content="Disk Temizle" Click="OnSysCleanDiskClick" />
                                                    <Button x:Name="BtnSysTrimRam" Style="{StaticResource DarkActionButtonStyle}" Padding="9,2.5" FontSize="9.8" Margin="0,0,6,0" Content="RAM Boşalt" Click="OnSysTrimRamClick" />
                                                    <Button x:Name="BtnSysCloseIdleApps" Style="{StaticResource DarkActionButtonStyle}" Padding="9,2.5" FontSize="9.8" Content="Boşta Uygulamalar" Click="OnSysScanIdleAppsClick" />
                                                </StackPanel>
                                                <TextBlock x:Name="SysMaintStatusText"
                                                           Grid.Column="1"
                                                           Text=""
                                                           FontFamily="{StaticResource UiTextFont}"
                                                           FontSize="9.6"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentCyanBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="3" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="16" Padding="10,7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                                    <TextBlock x:Name="SysProcHeaderText"
                                                               Text="Process Watchdog &amp; Hung Detector"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="SysLiveBadgeText"
                                                               Text="● Live • 1s"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentGreenBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <ScrollViewer x:Name="SystemProcessScrollViewer" Style="{StaticResource ObsidianScrollViewerStyle}">
                                                        <StackPanel x:Name="SystemProcessStack" />
                                                    </ScrollViewer>
                                                    <Grid x:Name="SysIdleAppsConfirmPanel" Visibility="Collapsed">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <TextBlock x:Name="SysIdleConfirmTitleText"
                                                                       Text="Kapatılacak boşta arka plan uygulamaları"
                                                                       FontFamily="{StaticResource UiTextFont}"
                                                                       FontSize="10.2"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button x:Name="BtnSysCancelIdleApps" Style="{StaticResource PillTabButtonStyle}" Padding="7,1.5" FontSize="9.4" Margin="0,0,5,0" Content="İptal" Click="OnSysCancelIdleAppsClick" />
                                                                <Button x:Name="BtnSysConfirmCloseIdle" Style="{StaticResource DarkActionButtonStyle}" Foreground="{StaticResource AccentAmberBrush}" Padding="8,1.5" FontSize="9.4" Content="Seçilenleri Kapat" Click="OnSysConfirmCloseIdleAppsClick" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ScrollViewer Grid.Row="1" Style="{StaticResource ObsidianScrollViewerStyle}">
                                                            <StackPanel x:Name="SysIdleAppsCheckStack" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 6. WIDGETS TAB -->
                                    <Grid x:Name="TabWidgetsPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock x:Name="WidgetsHeaderTitle"
                                                       Text="Widget Cards"
                                                       FontFamily="{StaticResource UiTextFont}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnToolColorPicker" Style="{StaticResource PillTabButtonStyle}" Foreground="{StaticResource AccentCyanBrush}" Padding="8,3" FontSize="10" Margin="0,0,6,0" Content="Color Picker" Click="OnToolColorPickerClick" />
                                                <Button x:Name="BtnOpenWidgetsFolder" Style="{StaticResource PillTabButtonStyle}" Padding="8,3" FontSize="10" Content="Plugins Folder" Click="OnOpenWidgetsFolderClick" />
                                                <Button x:Name="BtnReloadWidgets" Style="{StaticResource PillTabButtonStyle}" Padding="8,3" FontSize="10" Margin="6,0,0,0" Content="Reload" Click="OnReloadWidgetsClick" />
                                            </StackPanel>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" Style="{StaticResource ObsidianScrollViewerStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <WrapPanel x:Name="WidgetsWrapPanel" Orientation="Horizontal" />
                                                    <TextBlock x:Name="WidgetsEmptyText"
                                                               Text="No active widget plugins."
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="0,6,0,6"
                                                               Visibility="Collapsed" />
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- 7. AI SUBSCRIPTION & QUOTA TRACKER TAB -->
                                    <Grid x:Name="TabAiQuotaPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Clean Header (No colliding text!) -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnAiDockLiveToggle"
                                                        Style="{StaticResource PillTabButtonStyle}"
                                                        Padding="8,2.5"
                                                        FontSize="9.3"
                                                        Margin="0,0,5,0"
                                                        Foreground="{StaticResource AccentCyanBrush}"
                                                        Content="Ada/Dock: Açık"
                                                        Click="OnAiDockLiveToggleClick" />
                                                <Button x:Name="BtnAiScanCli"
                                                        Style="{StaticResource PillTabButtonStyle}"
                                                        Padding="8,2.5"
                                                        FontSize="9.3"
                                                        Foreground="#FF64D2FF"
                                                        Content="↻ Canlı Yenile"
                                                        ToolTip="Eklediğiniz hesapların canlı kota verilerini yeniler"
                                                        Click="OnAiScanCliClick" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AiQuotaHeaderText"
                                                           Text="AI Kota &amp; Abonelikler"
                                                           FontFamily="{StaticResource UiTextFont}"
                                                           FontSize="12.2"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="AiQuotaSummaryPill"
                                                        Margin="8,0,0,0"
                                                        Padding="7.5,1.8"
                                                        CornerRadius="7"
                                                        Background="#1C30D158"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="AiQuotaSummaryText"
                                                               Text="0 Hesap"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="9.3"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentGreenBrush}" />
                                                </Border>
                                                <TextBlock x:Name="AiQuotaCliDetectedText"
                                                           Text=""
                                                           Visibility="Collapsed" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Row 1: Dedicated Per-AI Provider Launcher Bar (Click any AI to open its popup) -->
                                        <Border Grid.Row="1"
                                                Margin="0,0,0,7"
                                                Padding="6,4"
                                                CornerRadius="10"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="0.8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Hesap Ekle:"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="9.2"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,7,0" />
                                                    <Button x:Name="BtnAiConnectChatGpt"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF0E261F"
                                                            BorderBrush="#6610A37F"
                                                            Foreground="#FF30D158"
                                                            Padding="8,2.5"
                                                            FontSize="9.4"
                                                            FontWeight="SemiBold"
                                                            Margin="0,0,4,0"
                                                            Content="+ ChatGPT"
                                                            Tag="ChatGPT"
                                                            Click="OnAiQuickOpenProviderClick" />
                                                    <Button x:Name="BtnAiConnectClaude"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF281913"
                                                            BorderBrush="#66D97757"
                                                            Foreground="#FFFF9F0A"
                                                            Padding="8,2.5"
                                                            FontSize="9.4"
                                                            FontWeight="SemiBold"
                                                            Margin="0,0,4,0"
                                                            Content="+ Claude"
                                                            Tag="Claude"
                                                            Click="OnAiQuickOpenProviderClick" />
                                                    <Button x:Name="BtnAiConnectAntigravity"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF0F2233"
                                                            BorderBrush="#6638BDF8"
                                                            Foreground="#FF38BDF8"
                                                            Padding="8,2.5"
                                                            FontSize="9.4"
                                                            FontWeight="SemiBold"
                                                            Margin="0,0,4,0"
                                                            Content="+ Antigravity"
                                                            Tag="Antigravity"
                                                            Click="OnAiQuickOpenProviderClick" />
                                                    <Button x:Name="BtnAiConnectGemini"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF121E36"
                                                            BorderBrush="#664E8DF5"
                                                            Foreground="#FF64D2FF"
                                                            Padding="8,2.5"
                                                            FontSize="9.4"
                                                            FontWeight="SemiBold"
                                                            Margin="0,0,4,0"
                                                            Content="+ Gemini"
                                                            Tag="Gemini"
                                                            Click="OnAiQuickOpenProviderClick" />
                                                    <Button x:Name="BtnAiConnectCursor"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF1E1430"
                                                            BorderBrush="#66A855F7"
                                                            Foreground="#FFC084FC"
                                                            Padding="8,2.5"
                                                            FontSize="9.4"
                                                            FontWeight="SemiBold"
                                                            Margin="0,0,4,0"
                                                            Content="+ Cursor"
                                                            Tag="Cursor"
                                                            Click="OnAiQuickOpenProviderClick" />
                                                    <Button x:Name="BtnAiAddAccount"
                                                            Style="{StaticResource PillTabButtonStyle}"
                                                            Padding="7.5,2.5"
                                                            FontSize="9.2"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            Content="+ Özel / API"
                                                            Tag="Custom"
                                                            Click="OnAiQuickOpenProviderClick" />
                                                </StackPanel>
                                                <StackPanel x:Name="AiQuotaFilterPanel"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed" />
                                            </DockPanel>
                                        </Border>

                                        <!-- Row 2: Grouped AI Accounts (Only entered AIs are shown; zero empty clutter!) -->
                                        <ScrollViewer x:Name="AiQuotaScrollViewer" Grid.Row="2" Style="{StaticResource ObsidianScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled">
                                            <Grid>
                                                <StackPanel x:Name="AiQuotaWrapPanel" Orientation="Vertical" />
                                                <Border x:Name="AiQuotaEmptyCard"
                                                        CornerRadius="12"
                                                        Background="#10FFFFFF"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="0.8"
                                                        Padding="18,16"
                                                        Margin="0,12,0,8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        MaxWidth="460"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="Henüz Eklenmiş Bir Yapay Zeka Hesabı Yok"
                                                                   FontFamily="{StaticResource UiFont}"
                                                                   FontSize="11.8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,5" />
                                                        <TextBlock x:Name="AiQuotaEmptyText"
                                                                   Text="Yukarıdaki bar üzerinden kullandığınız yapay zekaya (+ ChatGPT, + Claude, + Antigravity, + Gemini) tıklayarak hesabınızı açılan pencerede bağlayın. Girmediğiniz yapay zekalar burada yer kaplamaz."
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="10.0"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>

                                <!-- In-Island Non-Activating Glass Overlay: Notification Detail -->
                                <Border x:Name="NotifDetailOverlay"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Background="#EC050609"
                                        CornerRadius="16"
                                        Visibility="Collapsed"
                                        MouseLeftButtonDown="OnOverlayBackdropMouseDown">
                                    <Border Width="420"
                                            MaxHeight="214"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="16"
                                            Background="#FF141822"
