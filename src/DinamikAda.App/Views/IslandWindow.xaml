                                                    <TextBlock x:Name="TileWifiIcon" Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="12.5" Foreground="{StaticResource AccentBlueBrush}" />
                                                    <TextBlock x:Name="TileWifiLabel" Text="Wi-Fi" FontFamily="{StaticResource UiTextFont}" FontSize="10.2" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
