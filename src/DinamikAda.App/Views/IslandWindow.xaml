                                                    <Button x:Name="BtnAiEditOAuthLogin"
                                                            DockPanel.Dock="Right"
                                                            Style="{StaticResource DarkActionButtonStyle}"
                                                            Background="#FF14352B"
                                                            BorderBrush="#8810A37F"
                                                            Foreground="#FF30D158"
                                                            Padding="11,4"
                                                            FontSize="9.8"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Content="🔑 OpenAI ile Giriş Yap"
                                                            Click="OnAiEditOAuthLoginClick" />
