                                                    <Button Style="{StaticResource PillTabButtonStyle}" Padding="5,2" FontSize="8.8" Content="30g" Click="OnAiEditWindowPresetClick" Tag="43200" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                    <TextBlock x:Name="AiQuotaEditBillingLabel" Text="Yenilenme Günü" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="AiQuotaEditBillingDayBox" MaxLength="2" Text="" Background="#FF0B0E14" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentCyanBrush}" BorderBrush="#36FFFFFF" BorderThickness="0.8" Padding="6,3" FontFamily="{StaticResource UiFont}" FontSize="10.4" ToolTip="Ayın yenilenme günü (1-31)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock x:Name="AiQuotaEditPriceLabel" Text="Fiyat / Not" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
