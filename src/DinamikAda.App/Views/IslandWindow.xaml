                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock x:Name="AiQuotaEditEmailLabel" Text="E-posta / Kullanıcı Notu" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="AiQuotaEditEmailBox" MaxLength="64" Background="#FF0B0E14" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentCyanBrush}" BorderBrush="#36FFFFFF" BorderThickness="0.8" Padding="6,3" FontFamily="{StaticResource UiTextFont}" FontSize="10.4" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Quota Limit & Remaining Row -->
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock x:Name="AiQuotaEditTotalLabel" Text="Toplam Hak" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="AiQuotaEditTotalBox" MaxLength="8" Text="80" Background="#FF0B0E14" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentCyanBrush}" BorderBrush="#36FFFFFF" BorderThickness="0.8" Padding="6,3" FontFamily="{StaticResource UiFont}" FontSize="10.4" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock x:Name="AiQuotaEditRemainingLabel" Text="Kalan" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
