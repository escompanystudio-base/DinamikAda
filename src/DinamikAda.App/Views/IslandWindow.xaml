                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock x:Name="AiQuotaEditNameLabel" Text="Hesap Etiketi" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="AiQuotaEditNameBox" MaxLength="36" Background="#FF0B0E14" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentCyanBrush}" BorderBrush="#36FFFFFF" BorderThickness="0.8" Padding="6,3" FontFamily="{StaticResource UiTextFont}" FontSize="10.4" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock x:Name="AiQuotaEditPlanLabel" Text="Plan / Paket" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
