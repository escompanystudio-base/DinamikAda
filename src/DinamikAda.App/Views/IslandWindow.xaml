                                                        <Button x:Name="BtnShelfClear" Style="{StaticResource PillTabButtonStyle}" Padding="5,2" FontSize="9.2" Margin="3,0,0,0" Content="Clear" Click="OnShelfClearClick" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <ScrollViewer x:Name="ShelfItemsScroll" Style="{StaticResource ObsidianScrollViewerStyle}">
                                                        <Grid>
                                                            <StackPanel x:Name="ShelfItemsStack" />
                                                            <TextBlock x:Name="ShelfEmptyText"
                                                                       Text="Shelf is empty"
                                                                       FontFamily="{StaticResource UiTextFont}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="Collapsed" />
                                                        </Grid>
                                                    </ScrollViewer>
                                                    <Border x:Name="ShelfQrOverlayBorder"
