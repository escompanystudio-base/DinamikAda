                                            <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock x:Name="AiQuotaEditProviderLabel" Text="Yapay Zeka:" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <Button x:Name="BtnAiEditProvChatGpt" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="ChatGPT" Click="OnAiEditProviderPickClick" Tag="ChatGPT" />
                                                <Button x:Name="BtnAiEditProvClaude" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Claude" Click="OnAiEditProviderPickClick" Tag="Claude" />
                                                <Button x:Name="BtnAiEditProvAntigravity" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Antigravity" Click="OnAiEditProviderPickClick" Tag="Antigravity" />
                                                <Button x:Name="BtnAiEditProvGemini" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Gemini" Click="OnAiEditProviderPickClick" Tag="Gemini" />
                                                <Button x:Name="BtnAiEditProvCursor" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Cursor" Click="OnAiEditProviderPickClick" Tag="Cursor" />
                                                <Button x:Name="BtnAiEditProvCopilot" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Copilot" Click="OnAiEditProviderPickClick" Tag="Copilot" />
                                                <Button x:Name="BtnAiEditProvCustom" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Content="Diğer" Click="OnAiEditProviderPickClick" Tag="Custom" />
                                            </StackPanel>

                                            <!-- Provider-Specific Official OAuth Banner -->
                                            <Border x:Name="AiQuotaEditOAuthBanner"
                                                    CornerRadius="10"
                                                    Background="#FF0E221D"
                                                    BorderBrush="#5510A37F"
                                                    BorderThickness="0.9"
                                                    Padding="10,6"
                                                    Margin="0,0,0,6">
