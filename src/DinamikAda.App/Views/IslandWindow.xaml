                                                        <Button x:Name="BtnAiUnitUse" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Adet" Click="OnAiEditUnitPickClick" Tag="use" />
                                                        <Button x:Name="BtnAiUnitPct" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="%" Click="OnAiEditUnitPickClick" Tag="pct" />
                                                        <Button x:Name="BtnAiUnitMsg" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Margin="0,0,3,0" Content="Mesaj" Click="OnAiEditUnitPickClick" Tag="msg" />
                                                        <Button x:Name="BtnAiUnitCredit" Style="{StaticResource PillTabButtonStyle}" Padding="6,2" FontSize="9.2" Content="Kredi" Click="OnAiEditUnitPickClick" Tag="credit" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock x:Name="AiQuotaEditThresholdLabel" Text="Uyarı (%)" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="AiQuotaEditThresholdBox" MaxLength="3" Text="20" Background="#FF0B0E14" Foreground="{StaticResource AccentAmberBrush}" CaretBrush="{StaticResource AccentCyanBrush}" BorderBrush="#36FFFFFF" BorderThickness="0.8" Padding="6,3" FontFamily="{StaticResource UiFont}" FontSize="10.4" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Window Reset & Monthly Billing Row -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock x:Name="AiQuotaEditWindowLabel" Text="Süre (dk)" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
