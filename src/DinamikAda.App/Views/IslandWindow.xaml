                                                                           Text="Uyku • 29:59"
                                                                           FontFamily="{StaticResource UiTextFont}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource AccentAmberBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Button x:Name="BtnSchedSnooze"
                                                                        Grid.Column="1"
                                                                        Style="{StaticResource PillTabButtonStyle}"
