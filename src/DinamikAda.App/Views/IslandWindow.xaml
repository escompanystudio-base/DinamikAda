                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource GlassCardBorderStyle}" CornerRadius="14" Padding="8,4">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock x:Name="ControlPowerHeader"
                                                                   Text="Power &amp; Session"
                                                                   FontFamily="{StaticResource UiTextFont}"
                                                                   FontSize="10.4"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" />
