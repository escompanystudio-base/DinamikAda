                                                    FontWeight="SemiBold"
                                                    Margin="0,2,0,6"
                                                    Content="En Yüksek Kaliteyi Kullan"
                                                    Click="OnAudioQualityUseMaxClick" />
                                            <ScrollViewer Grid.Row="2" Style="{StaticResource ObsidianScrollViewerStyle}" MaxHeight="96">
                                                <StackPanel x:Name="AudioQualityListPanel" />
                                            </ScrollViewer>
                                            <Grid Grid.Row="3" Margin="0,7,0,0">
                                                <TextBlock x:Name="AudioQualityStatusText"
                                                           Text=""
                                                           FontFamily="{StaticResource UiTextFont}"
                                                           FontSize="9.4"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button x:Name="BtnAudioQualitySettings"
