                                                    <TextBlock Text="&#xF407;" FontFamily="{StaticResource IconFont}" FontSize="12.5" Foreground="{StaticResource AccentCyanBrush}" />
                                                    <TextBlock x:Name="TileSnipLabel" Text="Snip" FontFamily="{StaticResource UiTextFont}" FontSize="10.2" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
