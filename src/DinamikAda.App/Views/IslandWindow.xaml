                                                            Grid.Column="1"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            ValueChanged="OnMicVolumeSliderChanged" />
                                                    <TextBlock x:Name="MicVolPctText"
                                                               Grid.Column="2"
                                                               Text="80%"
                                                               FontFamily="{StaticResource UiTextFont}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Instant Voice Note Recorder with Live 8-Bar Waveform -->
                                                <Border CornerRadius="10"
