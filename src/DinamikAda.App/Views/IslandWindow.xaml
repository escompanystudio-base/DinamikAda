                                                          Content="Adada bildir"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          FontFamily="{StaticResource UiTextFont}"
                                                          FontSize="9.4"
                                                          VerticalAlignment="Center" />
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AiQuotaEditCliLabel" Text="Kaynak:" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <Button x:Name="BtnAiCliManual" Style="{StaticResource PillTabButtonStyle}" Padding="5.5,2" FontSize="8.8" Margin="0,0,3,0" Content="Manuel" Click="OnAiEditCliPickClick" Tag="manual" />
                                                    <Button x:Name="BtnAiCliCodex" Style="{StaticResource PillTabButtonStyle}" Padding="5.5,2" FontSize="8.8" Margin="0,0,3,0" Content="ChatGPT" Click="OnAiEditCliPickClick" Tag="codex" />
                                                    <Button x:Name="BtnAiCliClaude" Style="{StaticResource PillTabButtonStyle}" Padding="5.5,2" FontSize="8.8" Margin="0,0,3,0" Content="Claude" Click="OnAiEditCliPickClick" Tag="claude" />
                                                    <Button x:Name="BtnAiCliAntigravity" Style="{StaticResource PillTabButtonStyle}" Padding="5.5,2" FontSize="8.8" Margin="0,0,3,0" Content="Antigravity" Click="OnAiEditCliPickClick" Tag="antigravity" />
                                                    <Button x:Name="BtnAiCliGemini" Style="{StaticResource PillTabButtonStyle}" Padding="5.5,2" FontSize="8.8" Margin="0,0,3,0" Content="Gemini" Click="OnAiEditCliPickClick" Tag="gemini" />
                                                    <Button x:Name="BtnAiCliApi" Style="{StaticResource PillTabButtonStyle}" Padding="5.5,2" FontSize="8.8" Content="API Key" Click="OnAiEditCliPickClick" Tag="api" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Optional DPAPI-Encrypted API Key Row (shown when 'api' mode selected) -->
                                            <Grid x:Name="AiQuotaEditApiKeyPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AiQuotaEditApiKeyLabel" Grid.Column="0" Text="API Key:" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
