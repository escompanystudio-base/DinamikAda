                                                    <TextBlock x:Name="TileCaffeineLabel" Text="Caffeine" FontFamily="{StaticResource UiTextFont}" FontSize="10.2" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="TileCaffeineSub" Text="Off" FontFamily="{StaticResource UiTextFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
