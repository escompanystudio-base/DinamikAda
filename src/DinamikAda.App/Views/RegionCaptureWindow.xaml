<Window x:Class="DinamikAda.App.Views.RegionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Cursor="Cross"
        Background="#0A0B0E">
    <Grid x:Name="RootGrid"
          MouseLeftButtonDown="OnMouseDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseUp"
          MouseRightButtonDown="OnMouseRightButtonDown">
        <Image x:Name="BackdropImage" Stretch="Fill" />
        <!-- Semi-dark overlay with clear punch-out hole via GeometryGroup (Region Capture mode) -->
        <Path x:Name="DimOverlayPath" Fill="#88000000" IsHitTestVisible="False">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullScreenRectGeom" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionHoleGeom" Rect="0,0,0,0" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>
        <Canvas IsHitTestVisible="False">
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#FF0A84FF"
                    BorderThickness="2"
                    CornerRadius="3" />
            <Border x:Name="HintPill"
                    Background="#E0141720"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,6"
                    Canvas.Left="24"
                    Canvas.Top="24">
                <TextBlock x:Name="HintText"
                           Foreground="#FFF5F5F7"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="OCR için bölge seçin · Esc ile iptal" />
            </Border>

            <!-- Eyedropper 8x Live Pixel Magnifier Loupe + Color Values HUD -->
            <Border x:Name="EyedropperHud"
                    Visibility="Collapsed"
                    Width="220"
                    Background="#EC0D0F15"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10"
                    Canvas.Left="24"
                    Canvas.Top="24">
                <StackPanel>
                    <!-- 15x15 source pixels rendered at 8x (120x120 DIPs) -->
                    <Border HorizontalAlignment="Center"
                            BorderBrush="#42FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#FF050608">
                        <Grid Width="120" Height="120">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,120,120" RadiusX="7" RadiusY="7" />
                            </Grid.Clip>
                            <Image x:Name="LoupeImage"
                                   Width="120"
                                   Height="120"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True" />
                            <!-- Subtle 4-arm crosshair + double-contrast reticle around exact center pixel [56..64] -->
                            <Canvas Width="120" Height="120" IsHitTestVisible="False">
                                <Rectangle Canvas.Left="0" Canvas.Top="60" Width="54" Height="1" Fill="#48FFFFFF" />
                                <Rectangle Canvas.Left="66" Canvas.Top="60" Width="54" Height="1" Fill="#48FFFFFF" />
                                <Rectangle Canvas.Left="60" Canvas.Top="0" Width="1" Height="54" Fill="#48FFFFFF" />
                                <Rectangle Canvas.Left="60" Canvas.Top="66" Width="1" Height="54" Fill="#48FFFFFF" />
                                <Border Canvas.Left="54"
                                        Canvas.Top="54"
                                        Width="12"
                                        Height="12"
                                        BorderBrush="#CC000000"
                                        BorderThickness="1"
                                        CornerRadius="1.5">
                                    <Border BorderBrush="#FFFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="1" />
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Live Swatch Circle + HEX + Pixel Coordinates -->
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="EyedropperSwatch"
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="#FF000000"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1.2"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="EyedropperHexText"
                                       Text="#000000"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#FFF5F5F7" />
                            <TextBlock x:Name="EyedropperCoordText"
                                       Text="0, 0 px"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       FontSize="10"
                                       Foreground="#FF8E8E93" />
                        </StackPanel>
                    </Grid>

                    <!-- RGB & HSL Readout Pill -->
                    <Border Margin="0,7,0,0"
                            Background="#14FFFFFF"
                            BorderBrush="#1EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,5">
                        <StackPanel>
                            <TextBlock x:Name="EyedropperRgbText"
                                       Text="rgb(0, 0, 0)"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       FontSize="11"
                                       Foreground="#FFE4E4E7" />
                            <TextBlock x:Name="EyedropperHslText"
                                       Text="hsl(0, 0%, 0%)"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       FontSize="11"
                                       Foreground="#FFA1A1AA"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Localized Shortcut Hint -->
                    <TextBlock x:Name="EyedropperHintText"
                               Margin="0,7,0,0"
                               Text="Sol Tık: #HEX Kopyala · Sağ Tık / Esc: İptal"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10"
                               Foreground="#FFA1A1AA"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
