<Window x:Class="DinamikAda.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DinamikAda Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ObsidianGlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StartTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkActionButtonStyle}">
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Padding" Value="4,7,4,5"/>
                <Setter Property="Background" Value="#FF171E2B"/>
                <Setter Property="BorderBrush" Value="#FF2A3445"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Tile" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#FF233651"/>
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="#FF456384"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="#FFA4D9FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#FF2A476B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="DockRootGrid" Background="{x:Null}" ClipToBounds="False">
        <!-- Floating macOS Icon Hover Tooltip -->
        <Border x:Name="DockTooltipBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="0"
                IsHitTestVisible="False"
                CornerRadius="7"
                Padding="8,3"
                Background="#F2080A10"
                BorderBrush="#2AFFFFFF"
                BorderThickness="0.8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTooltipTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <TextBlock x:Name="DockTooltipText"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>

        <!-- Centered Floating macOS-Style Obsidian Dock Capsule -->
        <Border x:Name="DockPillContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6"
                CornerRadius="18"
                Background="#EF06080E"
                BorderThickness="0.95"
                ClipToBounds="False"
                MouseEnter="OnDockMouseEnter"
                MouseMove="OnDockMouseMove"
                MouseLeave="OnDockMouseLeave"
                AllowDrop="True"
                DragEnter="OnDockDragOver"
                DragOver="OnDockDragOver"
                DragLeave="OnDockDragLeave"
                Drop="OnDockDrop">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="DockBorderGlowBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="DockBorderStop0" Color="#32FFFFFF" Offset="0.0" />
                    <GradientStop x:Name="DockBorderStop1" Color="#32FFFFFF" Offset="0.5" />
                    <GradientStop x:Name="DockBorderStop2" Color="#32FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockCapsuleOffsetTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Grid ClipToBounds="False">
                <!-- Synced Multi-Layer Ambient Glow rendered directly via rounded Border.Background (never leaks corners) -->
                <Border x:Name="DockAmbientOverlay" CornerRadius="17" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush x:Name="DockAuraWashBrush" StartPoint="0,0.2" EndPoint="1,0.8">
                            <GradientStop x:Name="DockAuraStop0" Color="#1E0A84FF" Offset="0.0" />
                            <GradientStop x:Name="DockAuraStop1" Color="#145E5CE6" Offset="0.5" />
                            <GradientStop x:Name="DockAuraStop2" Color="#1A64D2FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid IsHitTestVisible="False">
                        <Border x:Name="DockAuraOrbPrimaryBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraPrimaryBrush" Center="0.30,0.50" GradientOrigin="0.30,0.50" RadiusX="0.34" RadiusY="0.95">
                                    <GradientStop x:Name="DockOrbPrim0" Color="#600A84FF" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbPrim1" Color="#320A84FF" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DockAuraOrbSecondaryBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraSecondaryBrush" Center="0.65,0.45" GradientOrigin="0.65,0.45" RadiusX="0.32" RadiusY="0.95">
                                    <GradientStop x:Name="DockOrbSec0" Color="#565E5CE6" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbSec1" Color="#2C5E5CE6" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DockAuraOrbHighlightBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraHighlightBrush" Center="0.50,0.55" GradientOrigin="0.50,0.55" RadiusX="0.28" RadiusY="0.90">
                                    <GradientStop x:Name="DockOrbHi0" Color="#4E64D2FF" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbHi1" Color="#2664D2FF" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="1"
                                Margin="14,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.35"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- Dynamic App Slots + Separator + Island Sync + Trash + Clock -->
                <StackPanel x:Name="DockItemsHost"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="9,6,9,4"
                            ClipToBounds="False" />
            </Grid>
        </Border>

        <!-- Minimalist Obsidian Clock & Calendar Pop-Up -->
        <Popup x:Name="ClockCalendarPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-20"
               PopupAnimation="None"
               Opened="OnClockPopupOpened"
               Closed="OnClockPopupClosed">
            <Border x:Name="ClockCalendarCard"
                    Width="264"
                    CornerRadius="16"
                    Background="#F507090E"
                    BorderBrush="#2CFFFFFF"
                    BorderThickness="0.9">
                <Grid>
                    <!-- Subtle Synchronized Ambient Glow -->
                    <Border CornerRadius="15" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="PopupAuraStop0" Color="#1C0A84FF" Offset="0.0" />
                                <GradientStop x:Name="PopupAuraStop1" Color="#105E5CE6" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Height="1"
                                Margin="16,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.4" />
                    </Border>

                    <StackPanel Margin="14,13,14,12">
                        <!-- Live Digital Clock & Localized Date Header -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PopupClockHm"
                                           Text="19:35"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="PopupClockSec"
                                           Text=":00"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="2,0,0,3"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="PopupDateWeekday"
                                           Text="Pazartesi"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="PopupDateFull"
                                           Text="16 Kasım 2026"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.2"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,10" />

                        <!-- Month Switcher Header -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="PopupMonthTitle"
                                       DockPanel.Dock="Left"
                                       Text="Kasım 2026"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnPopupToday"
                                        Content="Bugün"
                                        Visibility="Collapsed"
                                        Margin="0,0,6,0"
                                        Padding="7,2"
                                        FontSize="10"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnPopupTodayClick" />
                                <Button x:Name="BtnPopupPrevMonth"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="10"
                                        Content="&#xE76B;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnPopupPrevMonthClick" />
                                <Button x:Name="BtnPopupNextMonth"
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="10"
                                        Content="&#xE76C;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnPopupNextMonthClick" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Weekday Header Row -->
                        <UniformGrid x:Name="PopupWeekdayGrid" Columns="7" Margin="0,0,0,4" />

                        <!-- 6x7 Calendar Days Grid -->
                        <UniformGrid x:Name="PopupDaysGrid" Columns="7" Rows="6" />

                        <!-- Minimalist Upcoming / Quick Jump Footer -->
                        <Border x:Name="PopupFooterBar"
                                Margin="0,10,0,0"
                                Padding="9,6"
                                CornerRadius="9"
                                Background="#0DFFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="0.7"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnPopupFooterClick">
                            <DockPanel>
                                <Ellipse x:Name="PopupMeetingDot"
                                         DockPanel.Dock="Left"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource AccentBlueBrush}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="&#xE76C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                                <TextBlock x:Name="PopupFooterText"
                                           Text="Bugün planlı etkinlik yok"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Minimalist Obsidian Background / System Tray Apps Flyout ("^" Chevron Menu) -->
        <Popup x:Name="TrayOverflowPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-20"
               PopupAnimation="None"
               Opened="OnTrayPopupOpened"
               Closed="OnTrayPopupClosed">
            <Border x:Name="TrayOverflowCard"
                    Width="388"
                    CornerRadius="20"
                    Background="#FF101520"
                    BorderBrush="#FF354158"
                    BorderThickness="1"
                    PreviewKeyDown="OnTrayCardPreviewKeyDown">
                <Grid>
                    <!-- Synchronized Ambient Glow -->
                    <Border CornerRadius="19" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="TrayPopupAuraStop0" Color="#1C0A84FF" Offset="0.0" />
                                <GradientStop x:Name="TrayPopupAuraStop1" Color="#105E5CE6" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Height="1"
                                Margin="16,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.4" />
                    </Border>

                    <StackPanel Margin="16,14">
                        <DockPanel Margin="2,0,2,8">
                            <Button x:Name="BtnTrayPopupRefresh"
                                    DockPanel.Dock="Right"
                                    Width="32" Height="32" Padding="0"
                                    FontFamily="{StaticResource IconFont}" FontSize="13"
                                    Content="&#xE72C;"
                                    Style="{StaticResource DarkActionButtonStyle}"
                                    Click="OnTrayPopupRefreshClick" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TrayPopupTitleText"
                                           Text="Arka Plan Uygulamaları"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="TrayPopupCountBadge"
                                        Margin="6,0,0,0"
                                        Padding="6,1"
                                        CornerRadius="7"
                                        Background="#1A64D2FF"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TrayPopupCountText"
                                               Text="0"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,8" />

                        <TextBlock x:Name="TrayPopupStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{StaticResource AccentCyanBrush}"
                                   Margin="2,0,2,10" AutomationProperties.LiveSetting="Polite"/>
                        <ScrollViewer x:Name="TrayAppsScroller" MaxHeight="320" Style="{StaticResource ObsidianScrollViewerStyle}">
                            <Grid>
                                <StackPanel x:Name="TrayOverflowGrid" />
                                <TextBlock x:Name="TrayPopupEmptyText"
                                           Text="Arka planda çalışan gizli uygulama yok"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,14,0,14"
                                           Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- DinamikAda Obsidian Liquid Glass Start & Launchpad Hub -->
        <Popup x:Name="StartLaunchPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-24"
               PopupAnimation="None"
               Opened="OnStartPopupOpened"
               Closed="OnStartPopupClosed">
            <Border x:Name="StartLaunchCard"
                    Width="560"
                    CornerRadius="22"
                    Background="#FF101520"
                    BorderBrush="#FF354158"
                    BorderThickness="1"
                    PreviewKeyDown="OnStartCardPreviewKeyDown">
                <Grid>
                    <!-- Synchronized Ambient Glow -->
                    <Border CornerRadius="21" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="StartPopupAuraStop0" Color="#1E0A84FF" Offset="0.0" />
                                <GradientStop x:Name="StartPopupAuraStop1" Color="#125E5CE6" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Height="1"
                                Margin="18,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.45" />
                    </Border>

                    <StackPanel Margin="18,16,18,14">
                        <!-- Top Brand + AI Status + Classic Windows Start Fallback + Settings -->
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnStartAiStatus"
                                        Margin="0,0,6,0"
                                        Padding="10,6"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartAiStatusClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StartAiStatusDot"
                                                 Width="6" Height="6"
                                                 Fill="{StaticResource AccentGreenBrush}"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartAiStatusText"
                                                   Text="AI Hazır"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartClassicWin"
                                        Width="32" Height="32"
                                        Margin="0,0,5,0"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="13"
                                        Content="&#xE753;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartClassicWindowsClick" />
                                <Button x:Name="BtnStartSettings"
                                        Width="32" Height="32"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="13"
                                        Content="&#xE713;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartSettingsClick" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34"
                                        CornerRadius="10"
                                        Margin="0,0,10,0"
                                        Background="#FF183659"
                                        BorderBrush="#FF365E87"
                                        BorderThickness="1">
                                    <UniformGrid Columns="2" Rows="2" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Margin="1" CornerRadius="2" Background="#F5F5F7" />
                                        <Border Margin="1" CornerRadius="2" Background="#93C5FD" />
                                        <Border Margin="1" CornerRadius="2" Background="#93C5FD" />
                                        <Border Margin="1" CornerRadius="2" Background="#64D2FF" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock x:Name="StartBadgeText" Text="Başlat"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Installed app search -->
                        <Grid Margin="0,0,0,12">
                            <Border CornerRadius="10" BorderThickness="1" Padding="36,0"
                                    MinHeight="42">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ComboBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource ComboBorderBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox x:Name="StartSearchBox"
                                         Style="{StaticResource ObsidianTextBoxStyle}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         FontSize="13"
                                         AutomationProperties.LabeledBy="{Binding ElementName=StartSearchPlaceholder}"
                                         TextChanged="OnStartSearchTextChanged"
                                         PreviewKeyDown="OnStartSearchPreviewKeyDown">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Border>
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       Text="&#xE721;"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="13,0,0,0"
                                       IsHitTestVisible="False" />
                            <TextBlock x:Name="StartSearchPlaceholder"
                                       Text="Uygulama ara…"
                                       FontFamily="{StaticResource UiTextFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="37,0,36,0"
                                       IsHitTestVisible="False" />
                            <Button x:Name="BtnStartSearchClear"
                                    Width="28" Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Padding="0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="9"
                                    Content="&#xE711;"
                                    Visibility="Collapsed"
                                    Style="{StaticResource DarkActionButtonStyle}"
                                    Click="OnStartSearchClearClick" />
                        </Grid>

                        <!-- DinamikAda shortcuts -->
                        <UniformGrid x:Name="StartShortcutGrid" Columns="4" Margin="-3,0,-3,14">
                            <Button x:Name="BtnStartModIsland"
                                    MinHeight="42"
                                    Style="{StaticResource StartTileButtonStyle}"
                                    Click="OnStartModuleIslandClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="15" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StartModIslandText" Text="Ada Akışı" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnStartModAi"
                                    MinHeight="42"
                                    Style="{StaticResource StartTileButtonStyle}"
                                    Click="OnStartModuleAiClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="15" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StartModAiText" Text="AI Kota" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnStartModSystem"
                                    MinHeight="42"
                                    Style="{StaticResource StartTileButtonStyle}"
                                    Click="OnStartModuleSystemClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="15" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StartModSystemText" Text="Sistem" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnStartModCommand"
                                    MinHeight="42"
                                    Style="{StaticResource StartTileButtonStyle}"
                                    Click="OnStartModuleCommandClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="15" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StartModCommandText" Text="Komut" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock x:Name="StartLaunchError" Visibility="Collapsed" TextWrapping="Wrap"
                                   Margin="2,0,2,10" FontSize="12" Foreground="#FFFFB4AB"
                                   AutomationProperties.LiveSetting="Assertive"/>

                        <!-- Installed Apps Section Header -->
                        <DockPanel Margin="2,0,2,6">
                            <TextBlock x:Name="StartAppsCountText"
                                       DockPanel.Dock="Right"
                                       Text="0 uygulama"
                                       FontFamily="{StaticResource UiTextFont}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="StartAppsSectionTitle"
                                       Text="Uygulamalar"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Scrollable 5-Column Obsidian App Grid -->
                        <ScrollViewer x:Name="StartAppsScrollViewer"
                                      Height="252"
                                      Margin="0,0,0,10"
                                      Style="{StaticResource ObsidianScrollViewerStyle}">
                            <Grid>
                                <UniformGrid x:Name="StartAppsGrid" Columns="5" VerticalAlignment="Top" />
                                <TextBlock x:Name="StartAppsEmptyText"
                                           Text="Eşleşen uygulama bulunamadı"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="12"
                                           Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>

                        <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,9" />

                        <!-- User Profile + System Utilities + Power Controls Footer -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnStartLock"
                                        Width="26" Height="26"
                                        Margin="0,0,5,0"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="11"
                                        Content="&#xE72E;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartLockClick" />
                                <Button x:Name="BtnStartPower"
                                        Width="26" Height="26"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource AccentAmberBrush}"
                                        Content="&#xE7E8;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartPowerClick" />
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="7,4"
                                        CornerRadius="9"
                                        Background="#0EFFFFFF"
                                        BorderBrush="#16FFFFFF"
                                        BorderThickness="0.6"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartUserNameText"
                                                   Text="Kullanıcı"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="10.2"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   MaxWidth="86"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnStartExplorer"
                                        Margin="0,0,5,0"
                                        Padding="7,4"
                                        FontSize="10"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartExplorerClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="10.5" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartExplorerText" Text="Gezgin" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartTerminal"
                                        Margin="0,0,5,0"
                                        Padding="7,4"
                                        FontSize="10"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartTerminalClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE756;" FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Terminal" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartTaskMgr"
                                        Padding="7,4"
                                        FontSize="10"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnStartTaskMgrClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="10.5" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartTaskMgrText" Text="Görev Yön." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
