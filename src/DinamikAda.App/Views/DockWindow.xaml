<Window x:Class="DinamikAda.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DinamikAda Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ObsidianGlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="DockRootGrid" Background="{x:Null}" ClipToBounds="False">
        <!-- Floating macOS Icon Hover Tooltip -->
        <Border x:Name="DockTooltipBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="0"
                IsHitTestVisible="False"
                CornerRadius="7"
                Padding="8,3"
                Background="#F2080A10"
                BorderBrush="#2AFFFFFF"
                BorderThickness="0.8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTooltipTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <TextBlock x:Name="DockTooltipText"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>

        <!-- Centered Floating macOS-Style Obsidian Dock Capsule -->
        <Border x:Name="DockPillContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6"
                CornerRadius="18"
                Background="#EF06080E"
                BorderThickness="0.95"
                ClipToBounds="False"
                MouseEnter="OnDockMouseEnter"
                MouseMove="OnDockMouseMove"
                MouseLeave="OnDockMouseLeave"
                AllowDrop="True"
                DragEnter="OnDockDragOver"
                DragOver="OnDockDragOver"
                DragLeave="OnDockDragLeave"
                Drop="OnDockDrop">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="DockBorderGlowBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="DockBorderStop0" Color="#32FFFFFF" Offset="0.0" />
                    <GradientStop x:Name="DockBorderStop1" Color="#32FFFFFF" Offset="0.5" />
                    <GradientStop x:Name="DockBorderStop2" Color="#32FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockCapsuleOffsetTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Grid ClipToBounds="False">
                <!-- Synced Multi-Layer Ambient Glow rendered directly via rounded Border.Background (never leaks corners) -->
                <Border x:Name="DockAmbientOverlay" CornerRadius="17" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush x:Name="DockAuraWashBrush" StartPoint="0,0.2" EndPoint="1,0.8">
                            <GradientStop x:Name="DockAuraStop0" Color="#1E0A84FF" Offset="0.0" />
                            <GradientStop x:Name="DockAuraStop1" Color="#145E5CE6" Offset="0.5" />
                            <GradientStop x:Name="DockAuraStop2" Color="#1A64D2FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid IsHitTestVisible="False">
                        <Border x:Name="DockAuraOrbPrimaryBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraPrimaryBrush" Center="0.30,0.50" GradientOrigin="0.30,0.50" RadiusX="0.34" RadiusY="0.95">
                                    <GradientStop x:Name="DockOrbPrim0" Color="#600A84FF" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbPrim1" Color="#320A84FF" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DockAuraOrbSecondaryBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraSecondaryBrush" Center="0.65,0.45" GradientOrigin="0.65,0.45" RadiusX="0.32" RadiusY="0.95">
                                    <GradientStop x:Name="DockOrbSec0" Color="#565E5CE6" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbSec1" Color="#2C5E5CE6" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DockAuraOrbHighlightBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraHighlightBrush" Center="0.50,0.55" GradientOrigin="0.50,0.55" RadiusX="0.28" RadiusY="0.90">
                                    <GradientStop x:Name="DockOrbHi0" Color="#4E64D2FF" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbHi1" Color="#2664D2FF" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="1"
                                Margin="14,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.35"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- Dynamic App Slots + Separator + Island Sync + Trash + Clock -->
                <StackPanel x:Name="DockItemsHost"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="9,6,9,4"
                            ClipToBounds="False" />
            </Grid>
        </Border>

        <!-- Minimalist Obsidian Clock & Calendar Pop-Up -->
        <Popup x:Name="ClockCalendarPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-10"
               PopupAnimation="None"
               Opened="OnClockPopupOpened"
               Closed="OnClockPopupClosed">
            <Border x:Name="ClockCalendarCard"
                    Width="264"
                    CornerRadius="16"
                    Background="#F507090E"
                    BorderBrush="#2CFFFFFF"
                    BorderThickness="0.9">
                <Grid>
                    <!-- Subtle Synchronized Ambient Glow -->
                    <Border CornerRadius="15" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="PopupAuraStop0" Color="#1C0A84FF" Offset="0.0" />
                                <GradientStop x:Name="PopupAuraStop1" Color="#105E5CE6" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Height="1"
                                Margin="16,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.4" />
                    </Border>

                    <StackPanel Margin="14,13,14,12">
                        <!-- Live Digital Clock & Localized Date Header -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PopupClockHm"
                                           Text="19:35"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="PopupClockSec"
                                           Text=":00"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="2,0,0,3"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="PopupDateWeekday"
                                           Text="Pazartesi"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="PopupDateFull"
                                           Text="16 Kasım 2026"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.2"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,10" />

                        <!-- Month Switcher Header -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="PopupMonthTitle"
                                       DockPanel.Dock="Left"
                                       Text="Kasım 2026"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnPopupToday"
                                        Content="Bugün"
                                        Visibility="Collapsed"
                                        Margin="0,0,6,0"
                                        Padding="7,2"
                                        FontSize="10"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnPopupTodayClick" />
                                <Button x:Name="BtnPopupPrevMonth"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="10"
                                        Content="&#xE76B;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnPopupPrevMonthClick" />
                                <Button x:Name="BtnPopupNextMonth"
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="10"
                                        Content="&#xE76C;"
                                        Style="{StaticResource DarkActionButtonStyle}"
                                        Click="OnPopupNextMonthClick" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Weekday Header Row -->
                        <UniformGrid x:Name="PopupWeekdayGrid" Columns="7" Margin="0,0,0,4" />

                        <!-- 6x7 Calendar Days Grid -->
                        <UniformGrid x:Name="PopupDaysGrid" Columns="7" Rows="6" />

                        <!-- Minimalist Upcoming / Quick Jump Footer -->
                        <Border x:Name="PopupFooterBar"
                                Margin="0,10,0,0"
                                Padding="9,6"
                                CornerRadius="9"
                                Background="#0DFFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="0.7"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnPopupFooterClick">
                            <DockPanel>
                                <Ellipse x:Name="PopupMeetingDot"
                                         DockPanel.Dock="Left"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource AccentBlueBrush}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="&#xE76C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                                <TextBlock x:Name="PopupFooterText"
                                           Text="Bugün planlı etkinlik yok"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Minimalist Obsidian Background / System Tray Apps Flyout ("^" Chevron Menu) -->
        <Popup x:Name="TrayOverflowPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-10"
               PopupAnimation="None"
               Opened="OnTrayPopupOpened"
               Closed="OnTrayPopupClosed">
            <Border x:Name="TrayOverflowCard"
                    Width="298"
                    CornerRadius="16"
                    Background="#FC080A10"
                    BorderBrush="#2CFFFFFF"
                    BorderThickness="0.9">
                <Grid>
                    <!-- Synchronized Ambient Glow -->
                    <Border CornerRadius="15" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="TrayPopupAuraStop0" Color="#1C0A84FF" Offset="0.0" />
                                <GradientStop x:Name="TrayPopupAuraStop1" Color="#105E5CE6" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Height="1"
                                Margin="16,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.4" />
                    </Border>

                    <StackPanel Margin="12,11,12,10">
                        <DockPanel Margin="2,0,2,8">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TrayPopupTitleText"
                                           Text="Arka Plan Uygulamaları"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="TrayPopupCountBadge"
                                        Margin="6,0,0,0"
                                        Padding="6,1"
                                        CornerRadius="7"
                                        Background="#1A64D2FF"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TrayPopupCountText"
                                               Text="0"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="9.2"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>
                            <Button x:Name="BtnTrayPopupRefresh"
                                    DockPanel.Dock="Right"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="10"
                                    Content="&#xE72C;"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource DarkActionButtonStyle}"
                                    Click="OnTrayPopupRefreshClick" />
                        </DockPanel>

                        <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,8" />

                        <ScrollViewer MaxHeight="240" Style="{StaticResource ObsidianScrollViewerStyle}">
                            <Grid>
                                <UniformGrid x:Name="TrayOverflowGrid" Columns="5" />
                                <TextBlock x:Name="TrayPopupEmptyText"
                                           Text="Arka planda çalışan gizli uygulama yok"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,14"
                                           Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
