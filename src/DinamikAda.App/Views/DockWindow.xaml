<Window x:Class="DinamikAda.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DinamikAda Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ObsidianGlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- ===== Start menu: calm, borderless tiles, quiet chips and icon buttons ===== -->
            <QuinticEase x:Key="StartSoftEase" EasingMode="EaseOut"/>
            <SolidColorBrush x:Key="StartTextPrimaryBrush" Color="#FFF4F4F6"/>
            <SolidColorBrush x:Key="StartTextBodyBrush" Color="#FFD6D6DB"/>
            <SolidColorBrush x:Key="StartTextSecondaryBrush" Color="#FF9A9AA3"/>
            <SolidColorBrush x:Key="StartTextTertiaryBrush" Color="#FF6E6E77"/>
            <SolidColorBrush x:Key="StartSectionLabelBrush" Color="#FF8B8B94"/>
            <SolidColorBrush x:Key="StartGlyphBrush" Color="#FFB4B4BC"/>

            <!-- App tile: no border; hover fill white 6% fades in 120 ms / out 200 ms; content lifts 1.5px -->
            <Style x:Key="StartTileButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="6,10,6,8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource StartTextBodyBrush}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Best" CornerRadius="14" Background="#14FFFFFF" Opacity="0"/>
                                <Border x:Name="Hover" CornerRadius="14" Background="#0FFFFFFF" Opacity="0"/>
                                <Border x:Name="Focus" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" Opacity="0"/>
                                <Border x:Name="Press" CornerRadius="14" Background="#08FFFFFF" Opacity="0"/>
                                <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="best">
                                    <Setter TargetName="Best" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource StartSoftEase}"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1.5" Duration="0:0:0.26" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource StartSoftEase}"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Press" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick action pill: soft fill, no border -->
            <Style x:Key="StartChipButtonStyle" TargetType="Button" BasedOn="{StaticResource StartTileButtonStyle}">
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Padding" Value="11,0,12,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border CornerRadius="17" Background="#0BFFFFFF"/>
                                <Border x:Name="Hover" CornerRadius="17" Background="#0DFFFFFF" Opacity="0"/>
                                <Border x:Name="Focus" CornerRadius="17" BorderBrush="#40FFFFFF" BorderThickness="1" Opacity="0"/>
                                <Border x:Name="Press" CornerRadius="17" Background="#08FFFFFF" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Press" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quiet icon button: transparent until hover -->
            <Style x:Key="StartIconButtonStyle" TargetType="Button" BasedOn="{StaticResource StartTileButtonStyle}">
                <Setter Property="Margin" Value="2,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource StartGlyphBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Hover" CornerRadius="10" Background="#12FFFFFF" Opacity="0"/>
                                <Border x:Name="Focus" CornerRadius="10" BorderBrush="#40FFFFFF" BorderThickness="1" Opacity="0"/>
                                <Border x:Name="Press" CornerRadius="10" Background="#08FFFFFF" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StartTextPrimaryBrush}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Press" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small dark glass tooltip used by Start menu controls (never the stock tooltip) -->
            <Style x:Key="StartGlassToolTipStyle" TargetType="ToolTip">
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Placement" Value="Top"/>
                <Setter Property="VerticalOffset" Value="-4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border x:Name="Pill" Margin="10,6,10,14" Padding="10,6" CornerRadius="10"
                                    Background="#F5141418" BorderBrush="#14FFFFFF" BorderThickness="1" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="3"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" RenderingBias="Performance"/>
                                </Border.Effect>
                                <ContentPresenter TextElement.FontFamily="{StaticResource UiTextFont}" TextElement.FontSize="12"
                                                  TextElement.Foreground="{StaticResource StartTextBodyBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsOpen" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource StartSoftEase}"/>
                                                <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="3" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Thin overlay scrollbar that only appears while the list is hovered -->
            <Style x:Key="StartScrollThumbStyle" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbFill" CornerRadius="2" Background="#38FFFFFF" Width="4" HorizontalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbFill" Property="Background" Value="#5CFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbFill" Property="Background" Value="#70FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StartScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource StartScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StartScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="Transparent">
                                <ScrollContentPresenter Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,-10,0"
                                           Opacity="0"
                                           Orientation="Vertical"
                                           Style="{StaticResource StartScrollBarStyle}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" BeginTime="0:0:0.5" EasingFunction="{StaticResource StartSoftEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="DockRootGrid" Background="{x:Null}" ClipToBounds="False">
        <!-- Dock hover tooltip: a small dark glass pill that fades and rises in after a short delay -->
        <Border x:Name="DockTooltipBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTooltipTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Border x:Name="DockTooltipPill"
                    Margin="0,0,0,4"
                    CornerRadius="10"
                    Padding="10,4,10,5"
                    Background="#F5141418"
                    BorderBrush="#16FFFFFF"
                    BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DockTooltipRise" X="0" Y="0" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" Color="#000000" />
                </Border.Effect>
                <TextBlock x:Name="DockTooltipText"
                           FontFamily="{StaticResource UiTextFont}"
                           FontSize="12"
                           Foreground="#FFF4F4F6"
                           TextOptions.TextFormattingMode="Ideal" />
            </Border>
        </Border>

        <!-- Rich AI quota tooltip card; a popup so it can rise above the short dock host window -->
        <Popup x:Name="DockAiTooltipPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               IsHitTestVisible="False"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=DockRootGrid}"
               PopupAnimation="None">
            <Border x:Name="DockAiTooltipShell" Padding="16,10,16,22" IsHitTestVisible="False">
                <Border x:Name="DockAiTooltipCard"
                        Width="248"
                        CornerRadius="14"
                        Padding="14,12,14,12"
                        Background="#F7141418"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DockAiTooltipRise" X="0" Y="0" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.42" Color="#000000" />
                    </Border.Effect>
                    <StackPanel x:Name="DockAiTooltipHost" />
                </Border>
            </Border>
        </Popup>

        <!-- Centered Floating macOS-Style Obsidian Dock Capsule -->
        <Border x:Name="DockPillContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6"
                CornerRadius="18"
                Background="#EF06080E"
                BorderThickness="0.95"
                ClipToBounds="False"
                MouseEnter="OnDockMouseEnter"
                MouseMove="OnDockMouseMove"
                MouseLeave="OnDockMouseLeave"
                MouseLeftButtonDown="OnDockPillMouseLeftButtonDown"
                MouseLeftButtonUp="OnDockPillMouseLeftButtonUp"
                MouseRightButtonUp="OnDockPillMouseRightButtonUp"
                AllowDrop="True"
                DragEnter="OnDockDragOver"
                DragOver="OnDockDragOver"
                DragLeave="OnDockDragLeave"
                Drop="OnDockDrop">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="DockBorderGlowBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="DockBorderStop0" Color="#32FFFFFF" Offset="0.0" />
                    <GradientStop x:Name="DockBorderStop1" Color="#32FFFFFF" Offset="0.5" />
                    <GradientStop x:Name="DockBorderStop2" Color="#32FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockCapsuleOffsetTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Grid ClipToBounds="False">
                <!-- Synced Multi-Layer Ambient Glow rendered directly via rounded Border.Background (never leaks corners) -->
                <Border x:Name="DockAmbientOverlay" CornerRadius="17" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush x:Name="DockAuraWashBrush" StartPoint="0,0.2" EndPoint="1,0.8">
                            <GradientStop x:Name="DockAuraStop0" Color="#1E0A84FF" Offset="0.0" />
                            <GradientStop x:Name="DockAuraStop1" Color="#145E5CE6" Offset="0.5" />
                            <GradientStop x:Name="DockAuraStop2" Color="#1A64D2FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid IsHitTestVisible="False">
                        <Border x:Name="DockAuraOrbPrimaryBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraPrimaryBrush" Center="0.30,0.50" GradientOrigin="0.30,0.50" RadiusX="0.34" RadiusY="0.95">
                                    <GradientStop x:Name="DockOrbPrim0" Color="#600A84FF" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbPrim1" Color="#320A84FF" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DockAuraOrbSecondaryBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraSecondaryBrush" Center="0.65,0.45" GradientOrigin="0.65,0.45" RadiusX="0.32" RadiusY="0.95">
                                    <GradientStop x:Name="DockOrbSec0" Color="#565E5CE6" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbSec1" Color="#2C5E5CE6" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DockAuraOrbHighlightBorder" CornerRadius="17" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="DockAuraHighlightBrush" Center="0.50,0.55" GradientOrigin="0.50,0.55" RadiusX="0.28" RadiusY="0.90">
                                    <GradientStop x:Name="DockOrbHi0" Color="#4E64D2FF" Offset="0.0" />
                                    <GradientStop x:Name="DockOrbHi1" Color="#2664D2FF" Offset="0.48" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="1"
                                Margin="14,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource ObsidianTopSpecularBrush}"
                                Opacity="0.35"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- Dynamic App Slots + Separator + Island Sync + Trash + Clock -->
                <StackPanel x:Name="DockItemsHost"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="9,6,9,4"
                            ClipToBounds="False" />
            </Grid>
        </Border>

        <!-- Clock & calendar panel: calm surface, soft today highlight, upcoming events -->
        <Popup x:Name="ClockCalendarPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-20"
               PopupAnimation="None"
               Opened="OnClockPopupOpened"
               Closed="OnClockPopupClosed">
            <Popup.Resources>
                <ResourceDictionary Source="/Themes/DockPanels.xaml" />
            </Popup.Resources>
            <Border x:Name="ClockCalendarShell" Padding="36,24,36,52">
                <Border x:Name="ClockCalendarCard"
                        Width="300"
                        CornerRadius="24"
                        Background="{StaticResource PanelSurfaceBrush}"
                        BorderBrush="{StaticResource PanelHairlineBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource PanelShadowEffect}"
                        PreviewKeyDown="OnClockCardPreviewKeyDown">
                    <Grid>
                        <!-- A whisper of the current media colour, top-left only -->
                        <Border CornerRadius="23" IsHitTestVisible="False" Opacity="0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="PopupAuraStop0" Color="#1C0A84FF" Offset="0.0" />
                                    <GradientStop x:Name="PopupAuraStop1" Color="#105E5CE6" Offset="0.4" />
                                    <GradientStop Color="#00000000" Offset="0.75" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="40" VerticalAlignment="Top" CornerRadius="23,23,0,0" IsHitTestVisible="False"
                                Background="{StaticResource PanelTopHighlightBrush}" />

                        <StackPanel x:Name="ClockCalendarContent" Margin="20,18,20,16">
                            <!-- Live clock and date -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock x:Name="PopupDateWeekday"
                                               Text="PAZARTESİ"
                                               Style="{StaticResource PanelSectionLabelStyle}"
                                               Margin="1,0,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PopupClockHm"
                                                   Text="19:35"
                                                   FontFamily="{StaticResource PanelDisplayFont}"
                                                   FontSize="32"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{StaticResource PanelTitleBrush}" />
                                        <TextBlock x:Name="PopupClockSec"
                                                   Text=":00"
                                                   FontFamily="{StaticResource PanelDisplayFont}"
                                                   FontSize="15"
                                                   FontWeight="Medium"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{StaticResource PanelTertiaryBrush}"
                                                   Margin="2,0,0,6"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="PopupDateFull"
                                           Text="16 Kasım 2026"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,7"
                                           FontFamily="{StaticResource PanelTextFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource PanelSecondaryBrush}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource PanelDividerBrush}" Margin="0,0,0,12" />

                            <!-- Month switcher -->
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPopupToday"
                                            Content="Bugün"
                                            Visibility="Collapsed"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource PanelChipButtonStyle}"
                                            Click="OnPopupTodayClick" />
                                    <Button x:Name="BtnPopupPrevMonth"
                                            Width="28"
                                            Height="28"
                                            FontSize="11"
                                            Content="&#xE76B;"
                                            Style="{StaticResource PanelIconButtonStyle}"
                                            Click="OnPopupPrevMonthClick" />
                                    <Button x:Name="BtnPopupNextMonth"
                                            Width="28"
                                            Height="28"
                                            FontSize="11"
                                            Content="&#xE76C;"
                                            Style="{StaticResource PanelIconButtonStyle}"
                                            Click="OnPopupNextMonthClick" />
                                </StackPanel>
                                <TextBlock x:Name="PopupMonthTitle"
                                           Text="Kasım 2026"
                                           FontFamily="{StaticResource PanelDisplayFont}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PanelTitleBrush}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Weekday labels (small caps) and the 6x7 month grid -->
                            <UniformGrid x:Name="PopupWeekdayGrid" Columns="7" Margin="0,2,0,2" />
                            <UniformGrid x:Name="PopupDaysGrid" Columns="7" Rows="6">
                                <UniformGrid.RenderTransform>
                                    <TranslateTransform x:Name="PopupDaysShift" X="0" />
                                </UniformGrid.RenderTransform>
                            </UniformGrid>

                            <Border Height="1" Background="{StaticResource PanelDividerBrush}" Margin="0,12,0,12" />

                            <!-- Upcoming events -->
                            <TextBlock x:Name="PopupUpcomingLabel"
                                       Text="YAKLAŞAN"
                                       Style="{StaticResource PanelSectionLabelStyle}"
                                       Margin="1,0,0,6" />
                            <StackPanel x:Name="PopupUpcomingList" Margin="-8,0,-8,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Popup>

        <!-- Dock widget detail card (content is built by the clicked widget tile) -->
        <Popup x:Name="WidgetCardPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-18"
               PopupAnimation="None"
               Opened="OnWidgetCardOpened"
               Closed="OnWidgetCardClosed">
            <Border x:Name="WidgetCardBorder"
                    Margin="12"
                    CornerRadius="18"
                    Background="#FF101520"
                    BorderBrush="#FF354158"
                    BorderThickness="1"
                    Padding="16,14"
                    PreviewKeyDown="OnWidgetCardPreviewKeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <ContentControl x:Name="WidgetCardHost" Focusable="False" />
            </Border>
        </Popup>

        <!-- Background apps panel ("^" in the dock): borderless list, quiet header, staggered entrance -->
        <Popup x:Name="TrayOverflowPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-20"
               PopupAnimation="None"
               Opened="OnTrayPopupOpened"
               Closed="OnTrayPopupClosed">
            <Popup.Resources>
                <ResourceDictionary Source="/Themes/DockPanels.xaml" />
            </Popup.Resources>
            <Border x:Name="TrayOverflowShell" Padding="36,24,36,52">
                <Border x:Name="TrayOverflowCard"
                        Width="340"
                        CornerRadius="24"
                        Background="{StaticResource PanelSurfaceBrush}"
                        BorderBrush="{StaticResource PanelHairlineBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource PanelShadowEffect}"
                        PreviewKeyDown="OnTrayCardPreviewKeyDown">
                    <Grid>
                        <!-- A whisper of the current media colour, top-left only -->
                        <Border CornerRadius="23" IsHitTestVisible="False" Opacity="0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="TrayPopupAuraStop0" Color="#1C0A84FF" Offset="0.0" />
                                    <GradientStop x:Name="TrayPopupAuraStop1" Color="#105E5CE6" Offset="0.4" />
                                    <GradientStop Color="#00000000" Offset="0.75" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="40" VerticalAlignment="Top" CornerRadius="23,23,0,0" IsHitTestVisible="False"
                                Background="{StaticResource PanelTopHighlightBrush}" />

                        <StackPanel Margin="20,18,14,12">
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="BtnTrayPopupRefresh"
                                        DockPanel.Dock="Right"
                                        Width="30" Height="30"
                                        Margin="8,0,2,0"
                                        Style="{StaticResource PanelIconButtonStyle}"
                                        Click="OnTrayPopupRefreshClick">
                                    <TextBlock Text="&#xE72C;" FontSize="14" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform x:Name="TrayRefreshRotate" Angle="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrayPopupTitleText"
                                               Text="Arka Plan Uygulamaları"
                                               FontFamily="{StaticResource PanelDisplayFont}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PanelTitleBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="TrayPopupCountBadge"
                                            Margin="8,1,0,0"
                                            Padding="7,1,7,2"
                                            MinWidth="22"
                                            CornerRadius="999"
                                            Background="#14FFFFFF"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TrayPopupCountText"
                                                   Text="0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource PanelTextFont}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{StaticResource PanelSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{StaticResource PanelDividerBrush}" Margin="0,0,6,6" />

                            <TextBlock x:Name="TrayPopupStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                                       FontFamily="{StaticResource PanelTextFont}"
                                       FontSize="12" Foreground="{StaticResource PanelSecondaryBrush}"
                                       Margin="4,4,12,6" AutomationProperties.LiveSetting="Polite"/>
                            <ScrollViewer x:Name="TrayAppsScroller" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{StaticResource ObsidianScrollViewerStyle}">
                                <Grid Margin="-10,0,4,0">
                                    <StackPanel x:Name="TrayOverflowGrid" />
                                    <StackPanel x:Name="TrayPopupEmptyState"
                                                HorizontalAlignment="Center"
                                                Margin="16,16,16,14"
                                                Visibility="Collapsed">
                                        <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <Ellipse Fill="#0FFFFFFF" />
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="{StaticResource PanelIconFont}"
                                                       FontSize="15"
                                                       Foreground="{StaticResource PanelGlyphBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="TrayPopupEmptyText"
                                                   Text="Arka planda çalışan gizli uygulama yok"
                                                   FontFamily="{StaticResource PanelTextFont}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource PanelBodyBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock x:Name="TrayPopupEmptyHint"
                                                   Text="Her şey sakin."
                                                   FontFamily="{StaticResource PanelTextFont}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource PanelTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Popup>

        <!-- DinamikAda Start menu: calm dark panel, borderless app grid, quiet chips and icon buttons -->
        <Popup x:Name="StartLaunchPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Top"
               VerticalOffset="-24"
               PopupAnimation="None"
               Opened="OnStartPopupOpened"
               Closed="OnStartPopupClosed">
            <!-- The shell leaves room around the card so its soft shadow is never clipped by the popup window -->
            <Grid x:Name="StartLaunchShell" Background="{x:Null}" RenderTransformOrigin="0.5,1">
                <Border x:Name="StartLaunchShadow"
                        Margin="36"
                        CornerRadius="24"
                        Background="#FF0F0F12"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="18" Direction="270" Opacity="0.45" Color="#000000" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
                <Border x:Name="StartLaunchCard"
                        Margin="36"
                        Width="560"
                        CornerRadius="24"
                        Background="#F00F0F12"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        PreviewKeyDown="OnStartCardPreviewKeyDown">
                    <Grid>
                        <!-- Faint wash of the current accent, then the top inner highlight -->
                        <Border CornerRadius="23" IsHitTestVisible="False" Opacity="0.45">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="StartPopupAuraStop0" Color="#1E0A84FF" Offset="0.0" />
                                    <GradientStop x:Name="StartPopupAuraStop1" Color="#125E5CE6" Offset="0.45" />
                                    <GradientStop Color="#00000000" Offset="0.9" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="40" VerticalAlignment="Top" CornerRadius="23,23,0,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0DFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel x:Name="StartContentStack" Margin="22,20,22,12">
                            <!-- Header: title + quiet status cluster -->
                            <DockPanel x:Name="StartHeaderRow" Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnStartAiStatus"
                                            Style="{StaticResource StartChipButtonStyle}"
                                            Height="30"
                                            Margin="0,0,4,0"
                                            Padding="11,0"
                                            Click="OnStartAiStatusClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StartAiStatusDot"
                                                     Width="6" Height="6"
                                                     Fill="{StaticResource AccentGreenBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="StartAiStatusText"
                                                       Text="AI Hazır"
                                                       FontFamily="{StaticResource UiTextFont}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StartTextBodyBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnStartClassicWin"
                                            Style="{StaticResource StartIconButtonStyle}"
                                            Click="OnStartClassicWindowsClick">
                                        <UniformGrid Columns="2" Rows="2" Width="12" Height="12">
                                            <Border Margin="0.75" CornerRadius="1" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Border Margin="0.75" CornerRadius="1" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Border Margin="0.75" CornerRadius="1" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Border Margin="0.75" CornerRadius="1" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </UniformGrid>
                                    </Button>
                                    <Button x:Name="BtnStartSettings"
                                            Style="{StaticResource StartIconButtonStyle}"
                                            Content="&#xE713;"
                                            Click="OnStartSettingsClick" />
                                </StackPanel>

                                <TextBlock x:Name="StartBadgeText"
                                           Text="Başlat"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource StartTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Search: soft filled field, leading glyph, accent focus ring -->
                            <Grid x:Name="StartSearchHost" Margin="0,0,0,14">
                                <Border x:Name="StartSearchGlow" CornerRadius="16" Margin="-2" BorderThickness="2"
                                        BorderBrush="#3364D2FF" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="StartSearchField" CornerRadius="14" BorderThickness="1" Padding="38,0,38,0" Height="42">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0FFFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#0AFFFFFF"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox x:Name="StartSearchBox"
                                             Style="{StaticResource ObsidianTextBoxStyle}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             FontFamily="{StaticResource UiTextFont}"
                                             FontSize="13.5"
                                             Foreground="{StaticResource StartTextPrimaryBrush}"
                                             CaretBrush="{StaticResource AccentCyanBrush}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=StartSearchPlaceholder}"
                                             GotKeyboardFocus="OnStartSearchFocusChanged"
                                             LostKeyboardFocus="OnStartSearchFocusChanged"
                                             TextChanged="OnStartSearchTextChanged"
                                             PreviewKeyDown="OnStartSearchPreviewKeyDown">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Border>
                                <TextBlock FontFamily="{StaticResource IconFont}"
                                           Text="&#xE721;"
                                           FontSize="14"
                                           Foreground="{StaticResource StartSectionLabelBrush}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           IsHitTestVisible="False" />
                                <TextBlock x:Name="StartSearchPlaceholder"
                                           Text="Uygulama ara…"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="13.5"
                                           Foreground="{StaticResource StartTextTertiaryBrush}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="39,0,40,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                                <Button x:Name="BtnStartSearchClear"
                                        Style="{StaticResource StartIconButtonStyle}"
                                        Width="26" Height="26"
                                        FontSize="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Content="&#xE711;"
                                        Visibility="Collapsed"
                                        Click="OnStartSearchClearClick" />
                            </Grid>

                            <!-- DinamikAda quick actions: soft pills -->
                            <WrapPanel x:Name="StartShortcutGrid" Margin="-3,0,-3,14">
                                <Button x:Name="BtnStartModIsland" Style="{StaticResource StartChipButtonStyle}" Click="OnStartModuleIslandClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="13" Foreground="{StaticResource StartGlyphBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartModIslandText" Text="Ada Akışı" FontFamily="{StaticResource UiTextFont}" FontSize="12.5" Foreground="{StaticResource StartTextBodyBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartModAi" Style="{StaticResource StartChipButtonStyle}" Click="OnStartModuleAiClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="13" Foreground="{StaticResource StartGlyphBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartModAiText" Text="AI Kota" FontFamily="{StaticResource UiTextFont}" FontSize="12.5" Foreground="{StaticResource StartTextBodyBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartModSystem" Style="{StaticResource StartChipButtonStyle}" Click="OnStartModuleSystemClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="13" Foreground="{StaticResource StartGlyphBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartModSystemText" Text="Sistem" FontFamily="{StaticResource UiTextFont}" FontSize="12.5" Foreground="{StaticResource StartTextBodyBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartModCommand" Style="{StaticResource StartChipButtonStyle}" Click="OnStartModuleCommandClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE765;" FontSize="13" Foreground="{StaticResource StartGlyphBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StartModCommandText" Text="Komut" FontFamily="{StaticResource UiTextFont}" FontSize="12.5" Foreground="{StaticResource StartTextBodyBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <TextBlock x:Name="StartLaunchError" Visibility="Collapsed" TextWrapping="Wrap"
                                       Margin="4,0,4,10" FontSize="12" FontFamily="{StaticResource UiTextFont}" Foreground="#FFFFB4AB"
                                       AutomationProperties.LiveSetting="Assertive"/>

                            <!-- Pinned apps -->
                            <StackPanel x:Name="StartPinnedSection" Margin="0,0,0,10">
                                <TextBlock x:Name="StartPinnedTitle"
                                           Text="SABİTLENENLER"
                                           Margin="4,0,0,6"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource StartSectionLabelBrush}" />
                                <UniformGrid x:Name="StartPinnedGrid" Columns="5" Margin="-2,0" VerticalAlignment="Top" />
                            </StackPanel>

                            <!-- All apps -->
                            <DockPanel x:Name="StartAppsHeader" Margin="4,0,4,6">
                                <TextBlock x:Name="StartEnterHint"
                                           DockPanel.Dock="Right"
                                           Visibility="Collapsed"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource StartTextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="StartAppsSectionTitle"
                                           Text="TÜM UYGULAMALAR"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource StartSectionLabelBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="StartAppsCountText"
                                           Text="0"
                                           Margin="8,0,0,0"
                                           FontFamily="{StaticResource UiTextFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource StartTextTertiaryBrush}"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <ScrollViewer x:Name="StartAppsScrollViewer"
                                          Height="252"
                                          Margin="-2,0,-2,10"
                                          Style="{StaticResource StartScrollViewerStyle}"
                                          ScrollChanged="OnStartAppsScrollChanged">
                                <ScrollViewer.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.035" />
                                        <GradientStop Color="#FF000000" Offset="0.86" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </ScrollViewer.OpacityMask>
                                <Grid>
                                    <UniformGrid x:Name="StartAppsGrid" Columns="5" VerticalAlignment="Top" />
                                    <TextBlock x:Name="StartAppsEmptyText"
                                               Text="Eşleşen uygulama bulunamadı"
                                               FontFamily="{StaticResource UiTextFont}"
                                               FontSize="13"
                                               Foreground="{StaticResource StartTextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="12,36,12,12"
                                               Visibility="Collapsed" />
                                </Grid>
                            </ScrollViewer>

                            <!-- Footer: user on the left, quiet system buttons on the right -->
                            <Border x:Name="StartFooterDivider" Height="1" Background="#0FFFFFFF" Margin="-22,0,-22,10" />
                            <DockPanel x:Name="StartFooterRow">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnStartExplorer" Style="{StaticResource StartIconButtonStyle}" Content="&#xE8B7;" Click="OnStartExplorerClick" />
                                    <Button x:Name="BtnStartTerminal" Style="{StaticResource StartIconButtonStyle}" Content="&#xE756;" Click="OnStartTerminalClick" />
                                    <Button x:Name="BtnStartTaskMgr" Style="{StaticResource StartIconButtonStyle}" Content="&#xE9D9;" Click="OnStartTaskMgrClick" />
                                    <Border Width="1" Height="16" Margin="8,0,6,0" Background="#14FFFFFF" VerticalAlignment="Center" />
                                    <Button x:Name="BtnStartLock" Style="{StaticResource StartIconButtonStyle}" Content="&#xE72E;" Click="OnStartLockClick" />
                                    <Button x:Name="BtnStartPower" Style="{StaticResource StartIconButtonStyle}" Content="&#xE7E8;" Click="OnStartPowerClick" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3A3A44" Offset="0" />
                                                <GradientStop Color="#FF24242B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock x:Name="StartUserInitialText"
                                                   Text="W"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource StartTextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="StartUserNameText"
                                               Text="Kullanıcı"
                                               FontFamily="{StaticResource UiTextFont}"
                                               FontSize="13"
                                               Foreground="{StaticResource StartTextBodyBrush}"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
